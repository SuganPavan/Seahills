---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { RESORT_PACKAGES } from '../data/packagesData';

const categories = ['All', 'Honeymoon', 'Adventure', 'Family', 'Luxury'];
---

<Layout
  title="All Resort Packages | Sea Hills Hotels & Resorts Andaman"
  description="Explore curated honeymoon, family, dive adventure, and luxury Andaman holiday packages across Sea Hills Port Blair and Havelock Island."
>
  <Header />

  <main class="bg-[#101416] text-[#F5F1E8] min-h-screen pt-32 pb-24 px-4 sm:px-8 lg:px-12">
    <div class="max-w-[1320px] mx-auto">
      <!-- Top Breadcrumb & Hero -->
      <div class="mb-12 border-b border-[#D6B66C]/20 pb-10">
        <a
          href="/#packages"
          class="inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.22em] text-[#D6B66C] hover:text-[#FFF3D6] transition-colors mb-5"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Back to Homepage</span>
        </a>

        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
          <div>
            <p class="text-[11px] uppercase tracking-[0.28em] text-[#D6B66C] font-semibold mb-3">
              Sea Hills Hotels &amp; Resorts · Port Blair &amp; Havelock
            </p>
            <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-[#F5F1E8] leading-[1.08]">
              All Andaman
              <span class="text-[#F3E7C4] italic font-normal"> Packages</span>
            </h1>
          </div>

          <p class="text-sm sm:text-[15px] text-[#C8BFAE] font-light leading-relaxed max-w-xl">
            Every itinerary combines our luxury Port Blair &amp; Havelock stays with multi-cuisine dining, Anubis Bar evenings, swimming pools, high-speed ferries, and curated water activities.
          </p>
        </div>

        <!-- Category Filters -->
        <div class="flex flex-wrap gap-2.5 mt-8">
          {categories.map((cat, idx) => (
            <button
              type="button"
              data-pkg-filter={cat}
              class={`pkg-filter-btn rounded-full px-5 py-2 text-[11px] uppercase tracking-[0.18em] font-semibold border transition-all duration-300 ${
                idx === 0
                  ? 'bg-[#D6B66C] text-[#101416] border-[#D6B66C]'
                  : 'bg-white/[0.03] text-[#F3E7C4] border-[#D6B66C]/35 hover:border-[#D6B66C]'
              }`}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Full Package Cards with Day-by-Day Itinerary -->
      <div class="space-y-10" id="packages-list">
        {RESORT_PACKAGES.map((pkg) => (
          <article
            id={pkg.slug}
            data-pkg-category={pkg.category}
            class="pkg-detail-card rounded-[24px] overflow-hidden bg-gradient-to-br from-[#171C20] via-[#13181B] to-[#101416] border border-[#D6B66C]/30 shadow-[0_24px_65px_rgba(0,0,0,0.6)] grid grid-cols-1 lg:grid-cols-12"
          >
            <!-- Left Image -->
            <div class="relative lg:col-span-5 min-h-[280px] lg:min-h-full overflow-hidden">
              <img
                src={pkg.image}
                alt={pkg.title}
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#101416]/85 via-transparent to-[#101416]/25"></div>
              <div class="absolute top-5 left-5 flex flex-wrap gap-2">
                <span class="rounded-full bg-[#101416]/85 backdrop-blur-md border border-[#D6B66C]/50 px-3.5 py-1 text-[10px] uppercase tracking-[0.2em] text-[#F3E7C4] font-semibold">
                  {pkg.badge}
                </span>
                <span class="rounded-full bg-[#101416]/85 backdrop-blur-md border border-white/15 px-3.5 py-1 text-[10px] font-mono text-[#F5F1E8]">
                  {pkg.duration}
                </span>
              </div>

              <div class="absolute bottom-5 left-5 right-5">
                <p class="text-[11px] uppercase tracking-[0.2em] text-[#D6B66C] font-semibold">
                  {pkg.destinations}
                </p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  {pkg.stays.map((stay) => (
                    <span class="text-[10px] text-[#F5F1E8] bg-[#101416]/80 border border-white/15 rounded-full px-2.5 py-1">
                      {stay}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Right Details & Itinerary -->
            <div class="lg:col-span-7 p-7 sm:p-9 flex flex-col justify-between gap-6">
              <div>
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 mb-4">
                  <div>
                    <span class="text-[10px] uppercase tracking-[0.24em] text-[#D6B66C] font-semibold">
                      {pkg.category} Package
                    </span>
                    <h2 class="font-serif text-2xl sm:text-3xl text-[#F5F1E8] mt-1">
                      {pkg.title}
                    </h2>
                  </div>

                  <div class="sm:text-right flex-shrink-0">
                    <p class="font-serif text-2xl sm:text-3xl text-[#F3E7C4]">{pkg.price}</p>
                    <p class="text-[11px] text-[#C8BFAE]/80">{pkg.priceNote}</p>
                  </div>
                </div>

                <p class="text-sm text-[#C8BFAE] leading-relaxed font-light mb-5">
                  {pkg.summary}
                </p>

                <!-- Highlights -->
                <div class="flex flex-wrap gap-2 mb-6">
                  {pkg.highlights.map((h) => (
                    <span class="text-[11px] text-[#F3E7C4] bg-white/[0.04] border border-[#D6B66C]/30 rounded-full px-3 py-1">
                      {h}
                    </span>
                  ))}
                </div>

                <!-- Day-by-Day Itinerary -->
                <div class="border-t border-white/10 pt-5">
                  <p class="text-[11px] uppercase tracking-[0.22em] text-[#D6B66C] font-semibold mb-3">
                    Curated Itinerary
                  </p>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    {pkg.itinerary.map((step) => (
                      <div class="rounded-xl bg-white/[0.03] border border-white/10 p-3">
                        <p class="text-[10px] font-mono uppercase tracking-wider text-[#D6B66C] font-semibold">
                          {step.day}
                        </p>
                        <p class="text-xs text-[#E5DFD2] mt-1 leading-relaxed">{step.detail}</p>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              <div class="pt-4 border-t border-white/10 flex flex-wrap items-center justify-between gap-4">
                <span class="text-xs text-[#C8BFAE]">
                  Customizable for flights, private ferries &amp; extra nights
                </span>
                <a
                  href="/#book-now"
                  class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-[#D6B66C] to-[#E8CD8E] hover:from-[#e6c880] hover:to-[#f6dea4] text-[#101416] px-6 py-2.5 text-[11px] uppercase tracking-[0.18em] font-bold transition-all"
                >
                  <span>Enquire Package</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>
</Layout>

<script>
  const filterBtns = Array.from(document.querySelectorAll('.pkg-filter-btn')) as HTMLElement[];
  const pkgCards = Array.from(document.querySelectorAll('.pkg-detail-card')) as HTMLElement[];

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.pkgFilter || 'All';

      filterBtns.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('bg-[#D6B66C]', active);
        b.classList.toggle('text-[#101416]', active);
        b.classList.toggle('border-[#D6B66C]', active);
        b.classList.toggle('bg-white/[0.03]', !active);
        b.classList.toggle('text-[#F3E7C4]', !active);
      });

      pkgCards.forEach((card) => {
        const cat = card.dataset.pkgCategory;
        card.style.display = target === 'All' || cat === target ? '' : 'none';
      });
    });
  });
</script>
