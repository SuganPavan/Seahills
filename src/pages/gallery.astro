---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const publicDir = path.join(process.cwd(), 'public');
const roomsColDir = path.join(publicDir, 'images', 'rooms-collection');
const diningScrollDir = path.join(publicDir, 'images', 'dining-scroll');
const imageExtRe = /\.(webp|jpe?g|png|avif)$/i;

function pickSyncedPhoto(dir: string, prefix: string, fallback: string): string {
  if (fs.existsSync(dir)) {
    const found = fs.readdirSync(dir).find((f) => f.startsWith(prefix) && imageExtRe.test(f));
    if (found) {
      const rel = path.relative(publicDir, path.join(dir, found)).replace(/\\/g, '/');
      return `/${rel}`;
    }
  }
  return fallback;
}

const galleryItems = [
  {
    title: 'Bamboo Saa Luxury Room · View 1',
    category: 'Resorts & Suites',
    location: 'Sea Hills Havelock Resort (410 sq. ft.)',
    image: pickSyncedPhoto(roomsColDir, 'hl-bamboo-saa-1', '/images/rooms-collection/hl-bamboo-saa-1.jpg'),
  },
  {
    title: 'Bamboo Saa Luxury Room · View 2',
    category: 'Resorts & Suites',
    location: 'Sea Hills Havelock Resort (410 sq. ft.)',
    image: pickSyncedPhoto(roomsColDir, 'hl-bamboo-saa-2', '/images/rooms-collection/hl-bamboo-saa-2.jpg'),
  },
  {
    title: 'La Bougainvillea Room with Bathtub · View 1',
    category: 'Resorts & Suites',
    location: 'Sea Hills Havelock Resort (410 sq. ft.)',
    image: pickSyncedPhoto(roomsColDir, 'hl-bougainvillea-1', '/images/rooms-collection/hl-bougainvillea-1.jpg'),
  },
  {
    title: 'La Bougainvillea Room with Bathtub · View 2',
    category: 'Resorts & Suites',
    location: 'Sea Hills Havelock Resort (410 sq. ft.)',
    image: pickSyncedPhoto(roomsColDir, 'hl-bougainvillea-2', '/images/rooms-collection/hl-bougainvillea-2.jpg'),
  },
  {
    title: 'VIP Lounge Sea View Suite · View 1',
    category: 'Resorts & Suites',
    location: 'Sea Hills Port Blair Hotel (452 sq. ft.)',
    image: pickSyncedPhoto(roomsColDir, 'pb-vip-lounge-1', '/images/rooms-collection/pb-vip-lounge-1.jpg'),
  },
  {
    title: 'VIP Lounge Sea View Suite · View 2',
    category: 'Resorts & Suites',
    location: 'Sea Hills Port Blair Hotel (452 sq. ft.)',
    image: pickSyncedPhoto(roomsColDir, 'pb-vip-lounge-2', '/images/rooms-collection/pb-vip-lounge-2.jpg'),
  },
  {
    title: 'Premium Sea View Suite',
    category: 'Resorts & Suites',
    location: 'Sea Hills Port Blair Hotel',
    image: pickSyncedPhoto(roomsColDir, 'pb-sea-view-1', '/images/rooms-collection/pb-sea-view-1.jpg'),
  },
  {
    title: 'Premium Pool View Suite',
    category: 'Swimming Pools',
    location: 'Sea Hills Port Blair Hotel',
    image: pickSyncedPhoto(roomsColDir, 'pb-pool-view-1', '/images/rooms-collection/pb-pool-view-1.jpg'),
  },
  {
    title: 'Standard Room · Port Blair',
    category: 'Resorts & Suites',
    location: 'Sea Hills Port Blair Hotel (269 sq. ft.)',
    image: pickSyncedPhoto(roomsColDir, 'pb-standard-1', '/images/rooms-collection/pb-standard-1.jpg'),
  },
  {
    title: 'Kramuka & Cleopatra Fine Dining',
    category: 'Dining & Bar',
    location: 'Sea Hills Havelock & Port Blair',
    image: pickSyncedPhoto(diningScrollDir, '02-hl-rest-01', '/images/rooms-collection/pb-pool-view-2.jpg'),
  },
  {
    title: 'Anubis Rooftop Lounge Bar',
    category: 'Dining & Bar',
    location: 'Sea Hills Port Blair Hotel',
    image: pickSyncedPhoto(diningScrollDir, '04-pb-bar-01', '/images/rooms-collection/pb-sea-view-2.jpg'),
  },
  {
    title: 'Celebrate Your Moments · Flower Decor',
    category: 'Islands & Coast',
    location: 'Sea Hills Special Stay Experience',
    image: pickSyncedPhoto(roomsColDir, 'special-flower-decor', '/images/rooms-collection/special-flower-decor.jpg'),
  },
];

const categories = ['All', 'Resorts & Suites', 'Dining & Bar', 'Swimming Pools', 'Islands & Coast'];
---

<Layout
  title="Full Gallery | Sea Hills Hotels & Resorts Andaman"
  description="Browse high-resolution photographs of Sea Hills Port Blair & Havelock suites, Egyptian-themed dining, Anubis Bar, outdoor pools, and Andaman beaches."
>
  <Header />

  <main class="bg-[#0D1113] text-[#F5F1E8] min-h-screen pt-32 pb-24 px-4 sm:px-8 lg:px-12">
    <div class="max-w-[1320px] mx-auto">
      <!-- Top Breadcrumb & Title -->
      <div class="mb-12 border-b border-[#D6B66C]/20 pb-10">
        <a
          href="/#gallery"
          class="inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.22em] text-[#D6B66C] hover:text-[#FFF3D6] transition-colors mb-5"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Back to Homepage</span>
        </a>

        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
          <div>
            <p class="text-[11px] uppercase tracking-[0.28em] text-[#D6B66C] font-semibold mb-3">
              Visual Chronicle · Port Blair &amp; Havelock
            </p>
            <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-[#F5F1E8] leading-[1.08]">
              Full Resort
              <span class="text-[#F3E7C4] italic font-normal"> Gallery</span>
            </h1>
          </div>

          <p class="text-sm sm:text-[15px] text-[#C8BFAE] font-light leading-relaxed max-w-xl">
            Explore every corner of Sea Hills Hotels &amp; Resorts—from private suites and lantern-lit dining rooms to Anubis Bar, infinity pools, and emerald island shores.
          </p>
        </div>

        <!-- Category Tabs -->
        <div class="flex flex-wrap gap-2.5 mt-8">
          {categories.map((cat, idx) => (
            <button
              type="button"
              data-gallery-filter={cat}
              class={`gallery-filter-btn rounded-full px-5 py-2 text-[11px] uppercase tracking-[0.18em] font-semibold border transition-all duration-300 ${
                idx === 0
                  ? 'bg-[#D6B66C] text-[#101416] border-[#D6B66C]'
                  : 'bg-white/[0.03] text-[#F3E7C4] border-[#D6B66C]/35 hover:border-[#D6B66C]'
              }`}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

      <!-- Gallery Grid -->
      <div class="gallery-page-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
        {galleryItems.map((item) => (
          <button
            type="button"
            data-gallery-card
            data-gallery-category={item.category}
            data-src={item.image}
            data-title={item.title}
            data-location={item.location}
            class="gallery-item-card group relative z-10 hover:z-40 text-left rounded-[20px] overflow-hidden border-2 border-[#D6B66C]/35 hover:border-[#FFF3D6] bg-[#151A1D] aspect-[4/3] shadow-[0_18px_45px_rgba(0,0,0,0.55)] hover:shadow-[0_28px_70px_rgba(0,0,0,0.9),0_0_32px_rgba(214,182,108,0.4)] hover:scale-[1.12] transition-all duration-400"
          >
            <img
              src={item.image}
              alt={item.title}
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#061015]/95 via-transparent to-[#061015]/55"></div>

            <!-- Top-Left Prominent Location Pin Badge on Same Photo -->
            <div class="pointer-events-none absolute top-3.5 left-3.5 right-3.5 flex items-center justify-between gap-2">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-[#06131A]/90 border border-[#E5C985] px-3 py-1 text-[10px] font-bold uppercase tracking-[0.14em] text-[#FFF3D6] group-hover:bg-[#D6B66C] group-hover:text-[#081014] transition-colors duration-300 shadow-lg">
                <svg class="w-3.5 h-3.5 text-[#E5C985] group-hover:text-[#081014] flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
                  <path fill-rule="evenodd" d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742zM12 13.5a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
                </svg>
                <span>{item.location}</span>
              </span>

              <span class="rounded-full bg-[#101416]/85 border border-[#D6B66C]/45 px-2.5 py-0.5 text-[9.5px] uppercase tracking-[0.15em] text-[#F3E7C4]">
                {item.category}
              </span>
            </div>

            <div class="pointer-events-none absolute bottom-3 left-3.5 right-3.5">
              <p class="text-[10px] uppercase tracking-[0.18em] text-[#FFE59E] font-bold mb-0.5 drop-shadow-[0_2px_4px_rgba(0,0,0,0.95)]">
                {item.location}
              </p>
              <h2 class="font-serif text-lg sm:text-xl text-white font-semibold leading-tight drop-shadow-[0_2px_6px_rgba(0,0,0,0.95)]">
                {item.title}
              </h2>
            </div>
          </button>
        ))}
      </div>
    </div>

    <!-- Lightbox Modal -->
    <div
      id="gallery-lightbox"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-[#0A0D0F]/92 backdrop-blur-xl p-4 sm:p-8"
    >
      <button
        type="button"
        id="lightbox-close"
        aria-label="Close Lightbox"
        class="absolute top-5 right-5 w-11 h-11 rounded-full bg-white/10 hover:bg-[#D6B66C] text-[#F5F1E8] hover:text-[#101416] flex items-center justify-center transition-colors"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <div class="max-w-5xl w-full">
        <img
          id="lightbox-img"
          src=""
          alt=""
          class="w-full max-h-[75vh] object-contain rounded-2xl border border-[#D6B66C]/35 shadow-2xl"
        />
        <div class="mt-4 flex items-center justify-between text-[#F5F1E8]">
          <div>
            <p id="lightbox-location" class="text-[11px] uppercase tracking-[0.22em] text-[#D6B66C]"></p>
            <h3 id="lightbox-title" class="font-serif text-2xl mt-0.5"></h3>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  const filterBtns = Array.from(document.querySelectorAll('.gallery-filter-btn')) as HTMLElement[];
  const cards = Array.from(document.querySelectorAll('.gallery-item-card')) as HTMLElement[];

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.galleryFilter || 'All';

      filterBtns.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('bg-[#D6B66C]', active);
        b.classList.toggle('text-[#101416]', active);
        b.classList.toggle('border-[#D6B66C]', active);
        b.classList.toggle('bg-white/[0.03]', !active);
        b.classList.toggle('text-[#F3E7C4]', !active);
      });

      cards.forEach((card) => {
        const cat = card.dataset.galleryCategory;
        card.style.display = target === 'All' || cat === target ? '' : 'none';
      });
    });
  });

  const lightbox = document.getElementById('gallery-lightbox');
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lbTitle = document.getElementById('lightbox-title');
  const lbLocation = document.getElementById('lightbox-location');
  const lbClose = document.getElementById('lightbox-close');

  cards.forEach((card) => {
    card.addEventListener('click', () => {
      if (!lightbox || !lbImg) return;
      lbImg.src = card.dataset.src || '';
      lbImg.alt = card.dataset.title || '';
      if (lbTitle) lbTitle.textContent = card.dataset.title || '';
      if (lbLocation) lbLocation.textContent = card.dataset.location || '';
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
    });
  });

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
  }

  lbClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
</script>
