<!-- ════════════════════════════════════════════════════════════════════════════
     INTEGRATED GSAP SCROLLTRIGGER & LENIS ENGINE (Client Script)
════════════════════════════════════════════════════════════════════════════ -->
<script>
  import Lenis from 'lenis';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({ ignoreMobileResize: true });

  const heroSectionEl = document.getElementById('hero-scrolly');
  let HERO_FRAME_URLS: string[] = [];
  try {
    HERO_FRAME_URLS = JSON.parse(heroSectionEl?.dataset.frames || '[]');
  } catch {
    HERO_FRAME_URLS = [];
  }
  const TOTAL_FRAMES = HERO_FRAME_URLS.length || 94;

  const frameUrl = (relIdx: number) => {
    if (HERO_FRAME_URLS[relIdx]) return HERO_FRAME_URLS[relIdx];
    const frameNum = 20 + relIdx;
    return `/frames/Home_Section/frame_${String(frameNum).padStart(4, '0')}.webp`;
  };

  const SCENES = [
    { name: 'The Grand Entrance', id: 'scene-0', targetProgress: 0.00 },
    { name: 'The Pool Oasis',     id: 'scene-1', targetProgress: 0.38 },
    { name: 'Island Suites',      id: 'scene-2', targetProgress: 0.72 }
  ];

  function initCinematicExperience() {
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1. Initialize Lenis Smooth Scroll
    let lenis: Lenis | null = null;
    if (!prefersReducedMotion) {
      lenis = new Lenis({
        duration: 1.0,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        gestureOrientation: 'vertical',
        smoothWheel: true,
        touchMultiplier: 1.2
      });

      // Synchronize Lenis with GSAP ScrollTrigger
      lenis.on('scroll', ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis?.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0);
    }

    // 2. Setup Canvas & Frame Rendering Engine
    const section = document.getElementById('hero-scrolly');
    const canvas = document.getElementById('scrolly-canvas') as HTMLCanvasElement | null;
    const fallback = document.getElementById('scrolly-fallback');
    const progressBar = document.getElementById('scrolly-progress-bar');
    const counterEl = document.getElementById('chapter-counter');
    const nameEl = document.getElementById('chapter-name');
    const scrollHint = document.getElementById('scroll-hint');

    if (!section || !canvas) return;

    const ctx = canvas.getContext('2d', { alpha: false });
    if (!ctx) return;

    const preloader = document.getElementById('hero-preloader');
    const preloaderBar = document.getElementById('hero-preloader-bar');
    const preloaderPct = document.getElementById('hero-preloader-pct');

    // Lock scroll until Hero frames finish downloading & decoding
    let preloaderClosed = false;
    if (preloader) {
      window.scrollTo(0, 0);
      document.documentElement.style.overflow = 'hidden';
      lenis?.stop();
    }

    function closePreloader() {
      if (preloaderClosed) return;
      preloaderClosed = true;
      document.documentElement.style.overflow = '';
      lenis?.start();
      ScrollTrigger.refresh();
      if (preloader) {
        preloader.style.opacity = '0';
        preloader.style.pointerEvents = 'none';
        setTimeout(() => {
          preloader.style.display = 'none';
        }, 550);
      }
    }

    // Safety fallback so slow networks never trap the user
    const safetyTimer = setTimeout(closePreloader, 12000);

    // In-memory decoded image buffer + in-flight deduplication
    const frames: (HTMLImageElement | null)[] = new Array(TOTAL_FRAMES).fill(null);
    const inFlightLoads = new Map<number, Promise<void>>();
    let loadedCount = 0;
    let lastDrawn = -1;
    let activeScene = 0;

    function markFrameReady() {
      loadedCount++;
      const pct = Math.min(100, Math.round((loadedCount / TOTAL_FRAMES) * 100));
      if (preloaderBar) preloaderBar.style.width = `${pct}%`;
      if (preloaderPct) preloaderPct.textContent = `${pct}%`;
      if (loadedCount >= TOTAL_FRAMES) {
        clearTimeout(safetyTimer);
        closePreloader();
      }
    }

    function resizeCanvas() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas!.width = Math.round(window.innerWidth * dpr);
      canvas!.height = Math.round(window.innerHeight * dpr);
      ctx!.imageSmoothingEnabled = true;
      ctx!.imageSmoothingQuality = 'high';
      lastDrawn = -1;
      draw(Math.round(frameTracker.frame));
    }

    function nearestLoaded(i: number): HTMLImageElement | null {
      if (frames[i] && frames[i]!.complete && frames[i]!.naturalWidth > 0) return frames[i];
      for (let o = 1; o < TOTAL_FRAMES; o++) {
        const left = i - o;
        if (left >= 0 && frames[left] && frames[left]!.complete && frames[left]!.naturalWidth > 0) return frames[left];
        const right = i + o;
        if (right < TOTAL_FRAMES && frames[right] && frames[right]!.complete && frames[right]!.naturalWidth > 0) return frames[right];
      }
      if (frames[0] && frames[0]!.complete && frames[0]!.naturalWidth > 0) return frames[0];
      return null;
    }

    function draw(i: number) {
      const img = nearestLoaded(i);
      if (!img || !img.complete || img.naturalWidth === 0) return;
      const cw = canvas!.width, ch = canvas!.height;
      
      const s = Math.max(cw / img.naturalWidth, ch / img.naturalHeight);
      const w = img.naturalWidth * s, h = img.naturalHeight * s;
      const x = (cw - w) / 2;
      const y = (ch - h) / 2;
      
      ctx!.drawImage(img, x, y, w, h);
      lastDrawn = i;
      if (fallback && fallback.style.opacity !== '0') {
        fallback.style.opacity = '0';
      }
    }

    function loadFrame(i: number): Promise<void> {
      if (frames[i]) return Promise.resolve();
      const existing = inFlightLoads.get(i);
      if (existing) return existing;

      const promise = new Promise<void>((resolve) => {
        const img = new Image();
        img.decoding = 'async';
        img.onload = () => {
          const finalize = () => {
            if (!frames[i]) {
              frames[i] = img;
              markFrameReady();
            }
            inFlightLoads.delete(i);
            const current = Math.round(frameTracker.frame);
            if (Math.abs(i - current) <= 1) {
              draw(current);
            }
            resolve();
          };
          if (typeof img.decode === 'function') {
            img.decode().then(finalize, finalize);
          } else {
            finalize();
          }
        };
        img.onerror = () => {
          inFlightLoads.delete(i);
          markFrameReady();
          resolve();
        };
        img.src = frameUrl(i);
      });

      inFlightLoads.set(i, promise);
      return promise;
    }

    // High-priority progressive preloading starting at frame_0020
    async function preloadAllFrames() {
      // 1. Immediately load frame 0 (frame_0020.webp) and draw right away
      await loadFrame(0);
      draw(0);

      // 2. Load milestone frames proportionally
      const milestones = [
        0,
        Math.round((TOTAL_FRAMES - 1) * 0.25),
        Math.round((TOTAL_FRAMES - 1) * 0.45),
        Math.round((TOTAL_FRAMES - 1) * 0.72),
        TOTAL_FRAMES - 1
      ];
      milestones.forEach(idx => loadFrame(idx));

      // 3. Sequentially buffer next 12 frames in small batches of 4 for smooth scroll start
      for (let i = 1; i <= Math.min(12, TOTAL_FRAMES - 1); i += 4) {
        const earlyBatch: Promise<void>[] = [];
        for (let j = i; j < Math.min(i + 4, 13, TOTAL_FRAMES); j++) {
          earlyBatch.push(loadFrame(j));
        }
        await Promise.all(earlyBatch);
      }

      // 4. Stream remaining frames in non-blocking batches of 6 so scrolling stays 60fps
      const remaining: number[] = [];
      for (let i = 13; i < TOTAL_FRAMES; i++) {
        if (!frames[i] && !milestones.includes(i)) remaining.push(i);
      }

      for (let i = 0; i < remaining.length; i += 6) {
        const batch = remaining.slice(i, i + 6);
        await Promise.all(batch.map(idx => loadFrame(idx)));
        await new Promise((r) => requestAnimationFrame(r));
      }
      clearTimeout(safetyTimer);
      closePreloader();
    }

    // 3. GSAP ScrollTrigger for Butter-Smooth 1:1 Frame Scrubbing (Zero Double-Lag)
    const frameTracker = { frame: 0 };

    gsap.to(frameTracker, {
      frame: TOTAL_FRAMES - 1,
      ease: "none",
      scrollTrigger: {
        trigger: section,
        start: "top top",
        end: "bottom bottom",
        scrub: prefersReducedMotion ? false : true,
        onUpdate: (self) => {
          const currentFrame = Math.min(TOTAL_FRAMES - 1, Math.max(0, Math.round(frameTracker.frame)));
          if (currentFrame !== lastDrawn) {
            draw(currentFrame);
          }

          const progress = self.progress;

          // Update Progress Bar & scroll hint
          if (progressBar) progressBar.style.width = `${Math.max(8, progress * 100)}%`;
          if (scrollHint) scrollHint.style.opacity = progress > 0.03 ? '0' : '1';

          // 3 Smooth Chapters:
          // 01: Gate / Grand Entrance (0% -> 38%)
          // 02: Pool Oasis (38% -> 72%)
          // 03: Hotel / Island Suites (72% -> 100%)
          let sceneIdx = 0;
          if (progress >= 0.72) {
            sceneIdx = 2;
          } else if (progress >= 0.38) {
            sceneIdx = 1;
          } else {
            sceneIdx = 0;
          }

          setActiveScene(sceneIdx);
        }
      }
    });

    // 4. Seamless Scene Cross-Fading (No Race Conditions, Never Stuck)
    function setActiveScene(idx: number) {
      if (idx === activeScene) return;

      const isMobile = window.innerWidth < 768;
      SCENES.forEach((scene, i) => {
        const el = document.getElementById(scene.id);
        if (!el) return;

        if (i === idx) {
          el.style.pointerEvents = 'auto';
          gsap.to(el, {
            opacity: 1,
            y: 0,
            duration: 0.3,
            ease: "power2.out",
            overwrite: true
          });
        } else if (i === activeScene) {
          el.style.pointerEvents = 'none';
          gsap.to(el, {
            opacity: 0,
            y: isMobile ? 0 : (i < idx ? -8 : 8),
            duration: 0.22,
            ease: "power2.inOut",
            overwrite: true
          });
        } else {
          el.style.pointerEvents = 'none';
          gsap.set(el, { opacity: 0, y: isMobile ? 0 : (i < idx ? -8 : 8) });
        }
      });

      activeScene = idx;

      if (counterEl) counterEl.textContent = `0${idx + 1} / 03`;
      if (nameEl) nameEl.textContent = SCENES[idx].name;

      document.querySelectorAll('.chapter-dot').forEach((btn, i) => {
        const dot = btn.querySelector('.dot-indicator');
        const label = btn.querySelector('.chapter-label');
        const on = i === idx;
        dot?.classList.toggle('bg-[#D6B66C]', on);
        dot?.classList.toggle('ring-4', on);
        dot?.classList.toggle('ring-[#D6B66C]/25', on);
        dot?.classList.toggle('scale-125', on);
        dot?.classList.toggle('bg-[#C8BFAE]/35', !on);
        label?.classList.toggle('opacity-100', on);
        label?.classList.toggle('text-[#D6B66C]', on);
        label?.classList.toggle('opacity-0', !on);
      });
    }

    // Direct Chapter Dot navigation with Lenis (Navigates to exact milestone frame)
    document.querySelectorAll('.chapter-dot').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetIdx = parseInt(btn.getAttribute('data-target') || '0', 10);
        const scene = SCENES[targetIdx];
        if (!scene) return;
        const track = section.offsetHeight - window.innerHeight;
        const targetY = section.offsetTop + scene.targetProgress * track;

        if (lenis) {
          lenis.scrollTo(targetY, { duration: 1.1 });
        } else {
          window.scrollTo({ top: targetY, behavior: 'smooth' });
        }
      });
    });

    window.addEventListener('resize', resizeCanvas, { passive: true });
    resizeCanvas();
    preloadAllFrames();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCinematicExperience);
  } else {
    initCinematicExperience();
  }
</script>
