---
// Hero.astro - SECTION 1: CINEMATIC SCROLL-CONTROLLED RESORT JOURNEY
// Starting Landing Page: frame_0020.webp
// Sequence: frame_0020.webp through frame_0120.webp (101 high-definition WebP frames)
// Palette: Champagne Gold (#D6B66C), Midnight Black (#101416), Soft Ivory (#F5F1E8), Warm Beige (#C8BFAE)
import fs from 'node:fs';
import path from 'node:path';
import MotionButton from './motion/MotionButton';
import MotionBadge from './motion/MotionBadge';

const heroFramesDir = path.join(process.cwd(), 'public', 'frames', 'Home_Section');
let heroFrameUrls: string[] = [];
if (fs.existsSync(heroFramesDir)) {
  heroFrameUrls = fs
    .readdirSync(heroFramesDir)
    .filter((f) => /^frame_\d+\.webp$/i.test(f))
    .sort()
    .filter((f) => {
      const m = f.match(/frame_(\d+)\.webp/i);
      return m ? parseInt(m[1], 10) >= 20 : false;
    })
    .map((f) => `/frames/Home_Section/${f}`);
}
---

<section id="hero-scrolly" class="relative w-full bg-[#101416]" style="height: 360vh;" data-frames={JSON.stringify(heroFrameUrls)}>

  <!-- LUXURY PRELOADER OVERLAY (Locks scroll until Hero frames finish downloading & decoding) -->
  <div
    id="hero-preloader"
    class="fixed inset-0 z-[100] bg-[#0A0F12] flex flex-col items-center justify-center px-6 transition-opacity duration-500"
    aria-live="polite"
  >
    <div class="relative w-24 h-24 flex items-center justify-center mb-6">
      <div class="absolute -inset-2 rounded-full border border-[#D6B66C]/15 animate-pulse"></div>
      <div class="absolute inset-0 rounded-full border-2 border-[#D6B66C]/20"></div>
      <div class="absolute inset-0 rounded-full border-2 border-transparent border-t-[#D6B66C] border-r-[#F3E7C4] animate-spin"></div>
      <svg viewBox="0 0 40 40" class="w-10 h-10 text-[#D6B66C]" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="20" cy="15" r="7" stroke-dasharray="2 2" />
        <path d="M20 22 C20 29 18 34 16 35" stroke-width="2" />
        <path d="M20 22 C14 18 10 20 8 23" />
        <path d="M20 22 C16 15 13 16 11 18" />
        <path d="M20 22 C26 18 30 20 32 23" />
        <path d="M20 22 C24 15 27 16 29 18" />
        <path d="M12 35 C17 34 23 34 28 35" />
      </svg>
    </div>

    <p class="font-cormorant text-3xl sm:text-4xl text-[#F5F1E8] tracking-[0.06em]">
      Sea Hills
    </p>
    <p class="text-[10px] uppercase tracking-[0.32em] text-[#D6B66C] mt-1 mb-6">
      Hotels &amp; Resorts · Andaman
    </p>

    <div class="w-56 sm:w-64 h-[2px] bg-white/10 rounded-full overflow-hidden">
      <div id="hero-preloader-bar" class="h-full w-0 bg-gradient-to-r from-[#D6B66C] via-[#FFF3D6] to-[#D6B66C] transition-all duration-150"></div>
    </div>
    <p class="mt-3 text-[11px] font-mono tracking-[0.22em] text-[#C8BFAE]">
      LOADING EXPERIENCE · <span id="hero-preloader-pct" class="text-[#F3E7C4]">0%</span>
    </p>
  </div>
  
  <!-- STICKY FULLSCREEN VIEWPORT (svh prevents mobile URL-bar resize jitter) -->
  <div id="hero-sticky-viewport" class="sticky top-0 h-[100svh] w-full overflow-hidden flex flex-col justify-between">
    
    <!-- CANVAS FOR ULTRA-CRISP 60FPS FRAME RENDERING -->
    <canvas
      id="scrolly-canvas"
      class="absolute inset-0 w-full h-full z-0 block"
      style="filter: contrast(1.02) brightness(1.03);"
      aria-hidden="true"
    ></canvas>

    <!-- FIRST-FRAME IMMEDIATE FALLBACK (0ms first paint starting at frame_0020.webp) -->
    <img
      id="scrolly-fallback"
      src="/frames/Home_Section/frame_0020.webp"
      alt="Illuminated grand entrance gates and architecture of Sea Hills Hotels & Resorts Andaman"
      class="absolute inset-0 w-full h-full object-cover z-0 pointer-events-none transition-opacity duration-300"
      style="object-position: center center; filter: contrast(1.02) brightness(1.03);"
      width="1600"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />

    <!-- SECOND VIDEO (Reveals immediately when the entrance gate opens on scroll) -->
    <video
      id="hero-second-video"
      src="/video/secondfile.mp4"
      muted
      playsinline
      loop
      preload="auto"
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover z-[1] opacity-0 pointer-events-none transition-opacity duration-500"
    ></video>

    <!-- REFINED MINIMAL LUXURY SCENE LIGHTING (Soft, subtle contrast preserving full architectural visibility) -->
    <!-- Subtle top bar gradient for navigation legibility -->
    <div class="absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-[#051218]/75 via-[#051218]/30 to-transparent pointer-events-none z-10"></div>
    <!-- Rich left-side ocean-navy vignette (matches reference image: crisp text on left, bright gates/video on right) -->
    <div class="absolute inset-y-0 left-0 w-full md:w-[58%] bg-gradient-to-r from-[#051218]/90 via-[#051218]/58 to-transparent pointer-events-none z-10"></div>
    <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-[#061822] via-[#061822]/45 to-transparent pointer-events-none z-10"></div>

    <!-- ════════════════════════════════════════════════════════════════════════════
         RIGHT CORNER VIDEO CTA: EXPLORE HOTEL WITH VIDEO (https://youtu.be/BNjJoiCPeHQ)
    ════════════════════════════════════════════════════════════════════════════ -->
    <div class="absolute right-4 sm:right-6 lg:right-10 top-20 sm:top-24 z-30">
      <a
        href="https://youtu.be/BNjJoiCPeHQ"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Explore Hotel with Video on YouTube"
        class="group inline-flex items-center gap-2.5 sm:gap-3 rounded-full bg-[#06141D]/88 hover:bg-[#081B27] backdrop-blur-xl border border-[#D6B66C]/80 hover:border-[#FFF3D6] pl-2 pr-4 sm:pr-5 py-1.5 sm:py-2 shadow-[0_12px_32px_rgba(0,0,0,0.65),0_0_22px_rgba(214,182,108,0.28)] hover:shadow-[0_14px_36px_rgba(214,182,108,0.45)] transition-all duration-300 no-underline"
      >
        <span class="relative flex items-center justify-center w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-gradient-to-br from-[#F3DFA2] via-[#D6B66C] to-[#B8923E] text-[#101416] shadow-[0_0_14px_rgba(214,182,108,0.55)] group-hover:scale-105 transition-transform duration-300 flex-shrink-0">
          <span class="pointer-events-none absolute -inset-1 rounded-full border border-[#D6B66C]/60 animate-ping opacity-45"></span>
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 ml-0.5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M8 5.14v14l11-7-11-7z" />
          </svg>
        </span>
        <span class="flex flex-col text-left leading-tight">
          <span class="text-[8.5px] sm:text-[9.5px] uppercase tracking-[0.22em] text-[#E5C985] font-semibold">
            Watch Official Tour
          </span>
          <span class="font-cormorant text-sm sm:text-base font-semibold text-[#FFF8EB] group-hover:text-[#F3E7C4] whitespace-nowrap">
            Explore Hotel with Video ↗
          </span>
        </span>
      </a>
    </div>

    <!-- ════════════════════════════════════════════════════════════════════════════
         VERTICAL CHAPTER NAVIGATION (Desktop right side)
    ════════════════════════════════════════════════════════════════════════════ -->
    <aside class="hidden md:flex flex-col gap-4 absolute right-6 lg:right-10 top-1/2 -translate-y-1/2 z-30 select-none">
      <button type="button" class="chapter-dot group flex items-center justify-end gap-3 text-right focus:outline-none cursor-pointer" data-target="0" aria-label="Go to Chapter 1: Grand Entrance">
        <span class="chapter-label text-[10px] tracking-[0.24em] text-[#F5F1E8] group-hover:text-[#D6B66C] uppercase font-medium transition-all opacity-0 group-hover:opacity-100 transform translate-x-2 group-hover:translate-x-0 drop-shadow">01 Grand Entrance</span>
        <span class="dot-indicator w-2 h-2 rounded-full bg-[#D6B66C] ring-4 ring-[#D6B66C]/25 scale-125 transition-all duration-300 shadow-sm"></span>
      </button>
      <button type="button" class="chapter-dot group flex items-center justify-end gap-3 text-right focus:outline-none cursor-pointer" data-target="1" aria-label="Go to Chapter 2: Suites & Balconies">
        <span class="chapter-label text-[10px] tracking-[0.24em] text-[#F5F1E8] group-hover:text-[#D6B66C] uppercase font-medium transition-all opacity-0 group-hover:opacity-100 transform translate-x-2 group-hover:translate-x-0 drop-shadow">02 Suites &amp; Balconies</span>
        <span class="dot-indicator w-2 h-2 rounded-full bg-[#C8BFAE]/45 group-hover:bg-[#D6B66C] transition-all duration-300 shadow-sm"></span>
      </button>
      <button type="button" class="chapter-dot group flex items-center justify-end gap-3 text-right focus:outline-none cursor-pointer" data-target="2" aria-label="Go to Chapter 3: Kramuka & Twilight">
        <span class="chapter-label text-[10px] tracking-[0.24em] text-[#F5F1E8] group-hover:text-[#D6B66C] uppercase font-medium transition-all opacity-0 group-hover:opacity-100 transform translate-x-2 group-hover:translate-x-0 drop-shadow">03 Kramuka &amp; Twilight</span>
        <span class="dot-indicator w-2 h-2 rounded-full bg-[#C8BFAE]/45 group-hover:bg-[#D6B66C] transition-all duration-300 shadow-sm"></span>
      </button>
    </aside>

    <!-- ════════════════════════════════════════════════════════════════════════════
         EDITORIAL STORYTELLING OVERLAYS: 5 SCENES WITH SOPHISTICATED HIERARCHY
         Synchronized with Keyframes from frame_0020.webp to frame_0120.webp
    ════════════════════════════════════════════════════════════════════════════ -->
    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 w-full pt-20 sm:pt-28 pb-4 flex-1 flex flex-col justify-center">
      
      <!-- STAGE CONTAINER (Positioned in upper-middle left over feathered vignette) -->
      <div class="relative w-full max-w-md sm:max-w-xl min-h-[160px] sm:min-h-[250px] flex items-center">

        <!-- SCENE 1: STARTING LANDING PAGE (Frame 20-36, Grand Entrance & Sanctuary) -->
        <div id="scene-0" class="scene-stage absolute inset-x-0 bottom-0 sm:inset-y-0 sm:my-auto flex flex-col justify-center pointer-events-auto transition-opacity duration-300 [text-shadow:0_2px_18px_rgba(0,0,0,0.95),0_1px_4px_rgba(0,0,0,0.9)]">

          <!-- Kicker Tag -->
          <p class="scene-kicker text-[10.5px] sm:text-xs tracking-[0.28em] uppercase font-sans font-semibold text-[#E8C97A] mb-2 sm:mb-3">
            WELCOME TO SEA HILLS
          </p>

          <!-- Heading -->
          <h1 class="font-cormorant text-[32px] sm:text-5xl lg:text-[58px] font-normal text-[#F5F1E8] leading-[1.04] tracking-[0.01em] mb-2 scene-title">
            Experience
            <span class="font-cormorant italic font-normal text-[#EED28A] text-[30px] sm:text-5xl lg:text-[54px] tracking-normal sm:mt-0.5 block">
              Andaman in Style
            </span>
          </h1>

          <!-- Sans-serif Description -->
          <p class="hidden sm:block text-sm sm:text-[15px] text-[#E5DFD2] font-light leading-relaxed tracking-[0.015em] mb-5 max-w-md scene-desc">
            Luxury stays, breathtaking views and unforgettable moments.
          </p>

          <div class="flex flex-wrap items-center gap-3 sm:gap-4 mt-2 sm:mt-0 scene-cta [text-shadow:none]">
            <a
              href="#rooms-suites-banner"
              class="hero-action-btn inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#F0D58B] via-[#D6B66C] to-[#C8A24E] hover:brightness-110 text-[#101416] font-semibold px-5 py-2.5 sm:px-6 sm:py-3 text-[11px] sm:text-xs tracking-[0.14em] uppercase shadow-[0_8px_24px_rgba(214,182,108,0.35)] transition-all no-underline [text-shadow:none]"
            >
              <span>Explore Our Resorts</span>
              <span>→</span>
            </a>
            <a
              href="#destinations-section"
              class="hero-action-btn hidden sm:inline-flex items-center justify-center gap-2 rounded-full bg-[#07131B]/75 hover:bg-[#07131B] text-[#F5F1E8] border border-[#D6B66C]/55 hover:border-[#F3E7C4] font-medium px-5 py-2.5 sm:px-6 sm:py-3 text-[11px] sm:text-xs tracking-[0.14em] uppercase transition-all no-underline [text-shadow:none]"
            >
              <span>Discover Andaman</span>
            </a>
          </div>
        </div>

        <!-- SCENE 2: LOBBY, POOL, BALCONIES & BATHTUB SUITES (secondfile.mp4 Part 1) -->
        <div id="scene-1" class="scene-stage absolute inset-x-0 bottom-0 sm:inset-y-0 sm:my-auto flex flex-col justify-center opacity-0 pointer-events-none transition-opacity duration-300 [text-shadow:0_2px_18px_rgba(0,0,0,0.95),0_1px_4px_rgba(0,0,0,0.9)]">

          <div class="scene-kicker inline-flex items-center gap-2 px-2.5 py-0.5 sm:px-3 sm:py-1 rounded-full bg-[#050D12]/65 border border-[#D6B66C]/45 text-[#E8D5A7] mb-2 sm:mb-2.5 shadow-sm w-fit">
            <span class="w-1.5 h-1.5 rounded-full bg-[#D6B66C]"></span>
            <span class="text-[9.5px] sm:text-[11px] tracking-[0.22em] uppercase font-sans font-medium">
              02 · Pool, Balconies &amp; Suites
            </span>
          </div>

          <h2 class="font-cormorant text-[28px] sm:text-4xl lg:text-[50px] font-normal text-[#F5F1E8] leading-[1.05] tracking-[0.015em] mb-1.5 scene-title">
            Private Balconies
            <span class="font-cormorant italic font-normal text-[#EED28A] text-2xl sm:text-3xl lg:text-[38px] tracking-normal sm:mt-0.5 block">
              &amp; Bathtub Suites
            </span>
          </h2>

          <p class="hidden sm:block text-sm text-[#F5F1E8]/95 font-light leading-relaxed tracking-[0.015em] mb-4 max-w-md scene-desc">
            From the coastal-art lobby and palm-framed pool to Bamboo Saa &amp; La Bougainvillea rooms with wooden-shuttered bathtubs and pool-view balconies.
          </p>

          <div class="hidden sm:flex flex-wrap gap-2 text-xs scene-badges">
            <MotionBadge client:load icon="✦">Palm-Framed Pool</MotionBadge>
            <MotionBadge client:load icon="✦" delay={0.08}>Bathtub Suites</MotionBadge>
            <MotionBadge client:load icon="✦" delay={0.16}>Pool-View Balconies</MotionBadge>
          </div>
        </div>

        <!-- SCENE 3: KRAMUKA RESTAURANT & TWILIGHT SANCTUARY (secondfile.mp4 Part 2) -->
        <div id="scene-2" class="scene-stage absolute inset-x-0 bottom-0 sm:inset-y-0 sm:my-auto flex flex-col justify-center opacity-0 pointer-events-none transition-opacity duration-300 [text-shadow:0_2px_18px_rgba(0,0,0,0.95),0_1px_4px_rgba(0,0,0,0.9)]">

          <div class="scene-kicker inline-flex items-center gap-2 px-2.5 py-0.5 sm:px-3 sm:py-1 rounded-full bg-[#050D12]/65 border border-[#D6B66C]/45 text-[#E8D5A7] mb-2 sm:mb-2.5 shadow-sm w-fit">
            <span class="w-1.5 h-1.5 rounded-full bg-[#D6B66C]"></span>
            <span class="text-[9.5px] sm:text-[11px] tracking-[0.22em] uppercase font-sans font-medium">
              03 · Kramuka Restaurant &amp; Twilight
            </span>
          </div>

          <h2 class="font-cormorant text-[28px] sm:text-4xl lg:text-[50px] font-normal text-[#F5F1E8] leading-[1.05] tracking-[0.015em] mb-1.5 scene-title">
            Kramuka Dining
            <span class="font-cormorant italic font-normal text-[#EED28A] text-2xl sm:text-3xl lg:text-[38px] tracking-normal sm:mt-0.5 block">
              &amp; Illuminated Nights
            </span>
          </h2>

          <p class="hidden sm:block text-sm text-[#F5F1E8]/95 font-light leading-relaxed tracking-[0.015em] mb-4 max-w-md scene-desc">
            Dine beneath sculpted chandeliers at Kramuka Restaurant with live culinary flames, then unwind in our glowing forest retreat.
          </p>

          <div class="flex flex-wrap items-center gap-3 sm:gap-4 mt-2 sm:mt-0 scene-cta [text-shadow:none]">
            <a
              href="#rooms-suites-banner"
              class="hero-action-btn inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#F0D58B] via-[#D6B66C] to-[#C8A24E] hover:brightness-110 text-[#101416] font-semibold px-5 py-2.5 sm:px-6 sm:py-3 text-[11px] sm:text-xs tracking-[0.14em] uppercase shadow-[0_8px_24px_rgba(214,182,108,0.35)] transition-all no-underline [text-shadow:none]"
            >
              <span>Explore Our Resorts</span>
              <span>→</span>
            </a>
            <a
              href="#destinations-section"
              class="hero-action-btn hidden sm:inline-flex items-center justify-center gap-2 rounded-full bg-[#07131B]/75 hover:bg-[#07131B] text-[#F5F1E8] border border-[#D6B66C]/55 hover:border-[#F3E7C4] font-medium px-5 py-2.5 sm:px-6 sm:py-3 text-[11px] sm:text-xs tracking-[0.14em] uppercase transition-all no-underline [text-shadow:none]"
            >
              <span>Discover Andaman</span>
            </a>
          </div>
        </div>

      </div>

    </div>

    <!-- ════════════════════════════════════════════════════════════════════════════
         BOTTOM FLOATING AREA: CHAPTER BAR + FLOATING PLAN YOUR STAY CARD + WAVE
    ════════════════════════════════════════════════════════════════════════════ -->
    <div class="relative z-30 w-full flex flex-col items-center">
      
      <!-- Current Chapter Label & Progress Line -->
      <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 pb-2.5 flex items-center justify-between text-[#F5F1E8]/90 text-xs select-none">
        <div class="flex items-center gap-2.5">
          <span id="chapter-counter" class="font-mono text-[#D6B66C] font-medium tracking-widest text-xs drop-shadow-sm">01 / 03</span>
          <span class="text-[#C8BFAE]/30">•</span>
          <span id="chapter-name" class="font-sans tracking-[0.22em] text-[#F5F1E8]/90 uppercase text-[11px] font-light drop-shadow-sm">The Grand Entrance</span>
        </div>

        <div class="hidden sm:block flex-1 max-w-xs mx-6 h-[2px] bg-white/15 rounded-full overflow-hidden shadow-sm">
          <div id="scrolly-progress-bar" class="h-full bg-[#D6B66C] w-[20%] transition-all duration-150"></div>
        </div>

        <div id="scroll-hint" class="flex items-center gap-2 text-[#C8BFAE]/90 hover:text-white transition-opacity duration-300 drop-shadow-sm">
          <span class="tracking-[0.25em] uppercase text-[10px] font-light">Scroll to explore</span>
          <svg class="w-3.5 h-3.5 animate-bounce text-[#D6B66C]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
          </svg>
        </div>
      </div>

      <!-- Plan Your Stay: ANIMATED FLOATING GLASS BAR -->
      <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 pb-3 sm:pb-5">
        <form
          id="hero-plan-stay-form"
          class="plan-stay-floating-card relative overflow-hidden rounded-2xl bg-[#06141D]/90 backdrop-blur-xl border border-[#D6B66C]/80 px-3.5 py-2.5 sm:px-6 sm:py-3.5 grid grid-cols-2 sm:grid-cols-4 lg:flex lg:items-center lg:justify-between gap-2.5 sm:gap-3 lg:gap-4 transition-all duration-300"
        >
          <!-- Animated Top & Bottom Golden Traveling Light Beams -->
          <span aria-hidden="true" class="plan-stay-beam-top pointer-events-none absolute top-0 left-0 h-[2px] w-40 bg-gradient-to-r from-transparent via-[#FFF3D6] to-transparent"></span>
          <span aria-hidden="true" class="plan-stay-beam-bottom pointer-events-none absolute bottom-0 right-0 h-[2px] w-40 bg-gradient-to-r from-transparent via-[#D6B66C] to-transparent"></span>

          <!-- Title -->
          <div class="relative z-10 col-span-2 sm:col-span-4 lg:w-auto flex items-center gap-2.5 lg:border-r lg:border-[#D6B66C]/25 lg:pr-4 flex-shrink-0">
            <div class="relative w-9 h-9 rounded-xl bg-[#D6B66C]/15 border border-[#D6B66C]/50 flex items-center justify-center flex-shrink-0 text-[#F3E7C4] shadow-[0_0_16px_rgba(214,182,108,0.28)]">
              <span class="pointer-events-none absolute -inset-0.5 rounded-xl border border-[#D6B66C]/45 animate-ping opacity-40"></span>
              <svg class="w-4 h-4 plan-stay-icon-float" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <rect x="3" y="4" width="18" height="18" rx="2" />
                <path stroke-linecap="round" d="M16 2v4M8 2v4M3 10h18" />
              </svg>
            </div>
            <div>
              <p class="font-cormorant text-lg sm:text-xl font-semibold hero-gold-shimmer leading-tight whitespace-nowrap">
                Plan Your Stay
              </p>
              <p class="flex items-center gap-1.5 text-[10px] text-[#DCD5C7] leading-tight whitespace-nowrap">
                <span class="w-1.5 h-1.5 rounded-full bg-[#E5C985] animate-pulse shadow-[0_0_6px_#E5C985]"></span>
                <span>Check availability instantly</span>
              </p>
            </div>
          </div>

          <!-- Destination (Havelock / Port Blair) -->
          <label class="relative z-10 col-span-1 lg:flex-1 lg:min-w-[140px] flex items-center gap-2 lg:border-r lg:border-[#D6B66C]/25 lg:pr-3 cursor-pointer">
            <svg class="w-4 h-4 text-[#D6B66C] flex-shrink-0 hidden sm:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-6-5.686-6-11a6 6 0 1112 0c0 5.314-6 11-6 11z" />
              <circle cx="12" cy="10" r="2.2" />
            </svg>
            <div class="min-w-0 flex-1">
              <span class="block text-[9.5px] uppercase tracking-[0.14em] text-[#C8BFAE]">Destination</span>
              <select
                id="hero-destination"
                class="w-full bg-transparent text-xs sm:text-[13px] font-medium text-[#F5F1E8] focus:outline-none cursor-pointer [&>option]:bg-[#07131B] [&>option]:text-[#F5F1E8]"
              >
                <option value="Havelock Island">Swaraj Dweep (Havelock)</option>
                <option value="Port Blair">Sri Vijaya Puram (Port Blair)</option>
              </select>
            </div>
          </label>

          <!-- Check-in Date -->
          <label class="relative z-10 col-span-1 lg:flex-1 lg:min-w-[130px] flex items-center gap-2 lg:border-r lg:border-[#D6B66C]/25 lg:pr-3 cursor-pointer">
            <svg class="w-4 h-4 text-[#D6B66C] flex-shrink-0 hidden sm:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
