        <path d="M20 22 C20 29 18 34 16 35" stroke-width="2" />
        <path d="M20 22 C14 18 10 20 8 23" />
        <path d="M20 22 C16 15 13 16 11 18" />
        <path d="M20 22 C26 18 30 20 32 23" />
        <path d="M20 22 C24 15 27 16 29 18" />
        <path d="M12 35 C17 34 23 34 28 35" />
      </svg>
    </div>

    <p class="font-cormorant text-3xl sm:text-4xl text-[#F5F1E8] tracking-[0.06em]">
      Sea Hills
    </p>
    <p class="text-[10px] uppercase tracking-[0.32em] text-[#D6B66C] mt-1 mb-6">
      Hotels &amp; Resorts · Andaman
    </p>

    <div class="w-56 sm:w-64 h-[2px] bg-white/10 rounded-full overflow-hidden">
      <div id="hero-preloader-bar" class="h-full w-0 bg-gradient-to-r from-[#D6B66C] via-[#FFF3D6] to-[#D6B66C] transition-all duration-150"></div>
    </div>
    <p class="mt-3 text-[11px] font-mono tracking-[0.22em] text-[#C8BFAE]">
