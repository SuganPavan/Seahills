    <!-- ════════════════════════════════════════════════════════════════════════════
         BOTTOM CONTROL BAR: SCROLL PROGRESS & COUNTER
    ════════════════════════════════════════════════════════════════════════════ -->
    <div class="relative z-30 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 pb-6 flex items-center justify-between text-[#F5F1E8]/90 text-xs select-none">
      
      <!-- Current Chapter Label -->
      <div class="flex items-center gap-2.5">
        <span id="chapter-counter" class="font-mono text-[#D6B66C] font-medium tracking-widest text-xs drop-shadow-sm">01 / 03</span>
