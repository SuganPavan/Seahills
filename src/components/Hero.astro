        <svg class="block w-full text-[#0A2635]" viewBox="0 0 1440 60" preserveAspectRatio="none" style="width: 100%; height: 32px;">
          <path d="M0,0 C240,40 480,55 720,30 C960,5 1200,45 1440,25 L1440,60 L0,60 Z" fill="currentColor"></path>
