        class="relative w-full h-[360px] sm:h-[480px] lg:h-[550px] rounded-[24px] overflow-hidden border border-[#D6B66C]/30 bg-[#151A1D] shadow-[0_30px_90px_rgba(0,0,0,0.65)]"
