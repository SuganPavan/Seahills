        </div>
        <h2 class="font-cormorant text-3xl sm:text-4xl lg:text-[2.85rem] font-normal text-[#F5F1E8] leading-[1.08]">
          Candlelight, Spirits
          <span class="italic text-[#F3E7C4] font-light"> &amp; Island Hospitality</span>
        </h2>
      </header>

      <!-- TOP FILTER BAR: Dining / Bar / Reception + Island Split -->
      <div class="flex flex-wrap items-center justify-between gap-3 mb-3.5">
        <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
          <button
            type="button"
            data-dining-filter="all"
            class="dining-filter-btn px-3.5 py-1.5 rounded-full text-[10.5px] uppercase tracking-[0.16em] font-semibold border border-[#D6B66C] bg-[#D6B66C] text-[#101416] transition-all"
          >
            All
          </button>
          <button
            type="button"
            data-dining-filter="dining"
            class="dining-filter-btn px-3.5 py-1.5 rounded-full text-[10.5px] uppercase tracking-[0.16em] font-medium border border-[#D6B66C]/35 bg-[#161C20] text-[#F3E7C4] hover:border-[#D6B66C] transition-all"
