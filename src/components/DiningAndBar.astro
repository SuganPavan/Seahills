            aria-hidden="true"
            class="absolute inset-0 w-full h-full object-cover scale-110 blur-2xl opacity-0 pointer-events-none"
            style="transition: opacity 0.65s ease;"
          />

          <!-- Crisp Full-View Foreground Images (Zero Top/Bottom Cropping, Native Sharpness) -->
          <img
            id="dining-slide-a"
            src={slides[0]?.src}
            alt={slides[0]?.title || 'Sea Hills Dining'}
            class="relative z-10 w-full h-full object-contain object-center opacity-100"
            style="transition: opacity 0.65s ease;"
            decoding="async"
          />
          <img
            id="dining-slide-b"
            src={slides[1]?.src || slides[0]?.src}
            alt={slides[1]?.title || 'Sea Hills Dining'}
            class="absolute inset-0 z-10 w-full h-full object-contain object-center opacity-0"
            style="transition: opacity 0.65s ease;"
            decoding="async"
          />

          <!-- Carousel Prev / Next Arrows -->
          <button
            type="button"
            id="dining-prev-btn"
            aria-label="Previous image"
            class="absolute left-3 sm:left-4 top-1/2 -translate-y-1/2 z-30 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-[#101416]/65 hover:bg-[#D6B66C] text-[#F3E7C4] hover:text-[#101416] border border-[#D6B66C]/45 flex items-center justify-center backdrop-blur-md transition-all shadow-lg"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>

          <button
            type="button"
            id="dining-next-btn"
            aria-label="Next image"
            class="absolute right-3 sm:right-4 top-1/2 -translate-y-1/2 z-30 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-[#101416]/65 hover:bg-[#D6B66C] text-[#F3E7C4] hover:text-[#101416] border border-[#D6B66C]/45 flex items-center justify-center backdrop-blur-md transition-all shadow-lg"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>

          <!-- Subtle Bottom Scrim for Inside-Image Caption -->
          <div class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[#070C10]/92 via-[#070C10]/50 to-transparent z-20"></div>

          <!-- EACH IMAGE CAPTION INSIDE THE IMAGE (Place + Title + Description + Counter) -->
          <div class="absolute inset-x-0 bottom-0 z-30 px-4 sm:px-7 pb-4 sm:pb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-2.5">
            <div class="min-w-0 max-w-2xl">
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <span class="w-1.5 h-1.5 rounded-full bg-[#D6B66C]"></span>
                <span id="dining-caption-place" class="text-[10px] uppercase tracking-[0.22em] text-[#D6B66C] font-semibold drop-shadow">
                  {slides[0]?.place}
                </span>
              </div>
              <h3 id="dining-caption-title" class="font-cormorant text-xl sm:text-3xl text-[#F5F1E8] leading-snug drop-shadow">
                {slides[0]?.title}
              </h3>
              <p id="dining-caption-desc" class="hidden sm:block text-xs sm:text-[13px] text-[#E5DFD2]/90 font-light mt-1 line-clamp-2 drop-shadow">
                {slides[0]?.description}
              </p>
            </div>

            <div class="flex-shrink-0 self-start sm:self-end">
              <span id="dining-photo-counter" class="inline-block px-3.5 py-1 rounded-full bg-[#101416]/80 backdrop-blur-md border border-[#D6B66C]/45 text-[11px] font-mono tracking-widest text-[#F3E7C4]">
                01 / {String(slides.length).padStart(2, '0')}
              </span>
            </div>
          </div>

          <!-- Thin Progress Line -->
          <div class="absolute inset-x-0 bottom-0 h-[3px] bg-white/10 z-30">
            <div id="dining-progress-bar" class="h-full bg-gradient-to-r from-[#D6B66C] via-[#FFF3D6] to-[#D6B66C]" style="width: 0%;"></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({ ignoreMobileResize: true });

  function initDiningSection() {
    const section = document.getElementById('dining-bar-banner');
    const imagePanel = document.getElementById('dining-image-panel') as HTMLElement | null;
    const rightText = document.getElementById('dining-right-text') as HTMLElement | null;
    const imgA = document.getElementById('dining-slide-a') as HTMLImageElement | null;
    const imgB = document.getElementById('dining-slide-b') as HTMLImageElement | null;
    const bgA = document.getElementById('dining-bg-a') as HTMLImageElement | null;
    const bgB = document.getElementById('dining-bg-b') as HTMLImageElement | null;
    const prevBtn = document.getElementById('dining-prev-btn');
    const nextBtn = document.getElementById('dining-next-btn');
    const progressBar = document.getElementById('dining-progress-bar');
    const placeEl = document.getElementById('dining-caption-place');
    const titleEl = document.getElementById('dining-caption-title');
    const descEl = document.getElementById('dining-caption-desc');
    const counterEl = document.getElementById('dining-photo-counter');
    const thumbStrip = document.getElementById('dining-thumb-strip');
    const filterBtns = Array.from(document.querySelectorAll('.dining-filter-btn')) as HTMLElement[];
    const islandPills = Array.from(document.querySelectorAll('.dining-island-pill')) as HTMLElement[];
    const thumbBtns = Array.from(document.querySelectorAll('.dining-thumb-btn')) as HTMLElement[];

    if (!section || !imagePanel || !imgA || !imgB) return;

    const slides: Array<{
      src: string;
      island: 'havelock' | 'portblair';
      filter: 'dining' | 'bar' | 'reception';
      place: string;
      title: string;
      description: string;
    }> = JSON.parse(section.dataset.slides || '[]');

    if (slides.length === 0) return;

    let activeFilter: 'all' | 'dining' | 'bar' | 'reception' = 'all';
    let activeIsland: 'all' | 'havelock' | 'portblair' = 'all';
    let filteredIndices: number[] = slides.map((_, i) => i);
    let currentPos = 0;
    let currentIdx = 0;
    let showingA = true;
    let isPaused = false;
    let isVisible = false;
    let hasExpanded = false;
    const AUTO_MS = 3200;
    let autoStart = performance.now();

    function updateCaptionAndThumbs(slideIdx: number) {
      const slide = slides[slideIdx];
      if (!slide) return;
      const displayPos = Math.max(1, filteredIndices.indexOf(slideIdx) + 1);

      if (placeEl) placeEl.textContent = slide.place;
      if (titleEl) titleEl.textContent = slide.title;
      if (descEl) descEl.textContent = slide.description;
      if (counterEl) {
        counterEl.textContent = `${String(displayPos).padStart(2, '0')} / ${String(filteredIndices.length).padStart(2, '0')}`;
      }

      thumbBtns.forEach((btn, i) => {
        const inFilter = filteredIndices.includes(i);
        btn.classList.toggle('hidden', !inFilter);
        const active = i === slideIdx;
        btn.classList.toggle('border-[#D6B66C]', active);
        btn.classList.toggle('ring-2', active);
        btn.classList.toggle('ring-[#D6B66C]/60', active);
        btn.classList.toggle('opacity-100', active);
        btn.classList.toggle('scale-[1.03]', active);
        btn.classList.toggle('border-white/15', !active);
        btn.classList.toggle('opacity-55', !active);
      });

      const activeThumb = thumbBtns[slideIdx];
      if (activeThumb && thumbStrip) {
        const left = activeThumb.offsetLeft - thumbStrip.clientWidth / 2 + activeThumb.clientWidth / 2;
        thumbStrip.scrollTo({ left: Math.max(0, left), behavior: 'smooth' });
      }
    }

    function showSlide(nextSlideIdx: number, force = false) {
      if (!force && nextSlideIdx === currentIdx) return;
      const slide = slides[nextSlideIdx];
      if (!slide) return;

      const incoming = showingA ? imgB : imgA;
      const outgoing = showingA ? imgA : imgB;
      const incomingBg = showingA ? bgB : bgA;
      const outgoingBg = showingA ? bgA : bgB;

      incoming.src = slide.src;
      incoming.alt = `${slide.place} — ${slide.title}`;
      incoming.style.opacity = '1';
      outgoing.style.opacity = '0';

      if (incomingBg && outgoingBg) {
        incomingBg.src = slide.src;
        incomingBg.style.opacity = '0.35';
        outgoingBg.style.opacity = '0';
      }

      showingA = !showingA;
      currentIdx = nextSlideIdx;
      const pos = filteredIndices.indexOf(currentIdx);
      currentPos = pos >= 0 ? pos : 0;
      autoStart = performance.now();
      updateCaptionAndThumbs(currentIdx);
    }

    function stepCarousel(delta: number) {
      if (filteredIndices.length === 0) return;
      currentPos = (currentPos + delta + filteredIndices.length) % filteredIndices.length;
      showSlide(filteredIndices[currentPos]);
    }

    function applyFilters() {
      filteredIndices = slides
        .map((s, i) => ({ s, i }))
        .filter(
          ({ s }) =>
            (activeFilter === 'all' || s.filter === activeFilter) &&
            (activeIsland === 'all' || s.island === activeIsland)
        )
        .map(({ i }) => i);

      // Fallback if e.g. Havelock + Bar has 0 items, reset island to all for that category
      if (filteredIndices.length === 0) {
        filteredIndices = slides
          .map((s, i) => ({ s, i }))
          .filter(({ s }) => activeFilter === 'all' || s.filter === activeFilter)
          .map(({ i }) => i);
      }
      if (filteredIndices.length === 0) {
        filteredIndices = slides.map((_, i) => i);
      }

      filterBtns.forEach((btn) => {
        const active = btn.dataset.diningFilter === activeFilter;
        btn.classList.toggle('bg-[#D6B66C]', active);
        btn.classList.toggle('text-[#101416]', active);
        btn.classList.toggle('border-[#D6B66C]', active);
        btn.classList.toggle('font-semibold', active);
        btn.classList.toggle('bg-[#161C20]', !active);
        btn.classList.toggle('text-[#F3E7C4]', !active);
        btn.classList.toggle('border-[#D6B66C]/35', !active);
      });

      islandPills.forEach((pill) => {
        const active = pill.dataset.diningIsland === activeIsland;
        pill.classList.toggle('border-[#D6B66C]/60', active);
        pill.classList.toggle('bg-[#D6B66C]/15', active);
        pill.classList.toggle('text-[#F3E7C4]', active);
        pill.classList.toggle('font-semibold', active);
        pill.classList.toggle('border-white/15', !active);
        pill.classList.toggle('bg-[#161C20]', !active);
        pill.classList.toggle('text-[#C8BFAE]', !active);
      });

      currentPos = 0;
      showSlide(filteredIndices[0], true);
    }

    // When reaching Dining section: image starts on Left (68%), then smoothly moves to 100% Full Card on first scroll (no pinning/sticking)
    function updateInitialExpand(p: number) {
      if (hasExpanded) return;
      if (window.innerWidth >= 1024) {
        const clamped = Math.min(1, Math.max(0, p));
        imagePanel!.style.width = `${68 + clamped * 32}%`;
        if (rightText) {
          rightText.style.opacity = String(Math.max(0, 1 - clamped * 2));
        }
        if (clamped >= 1) {
          hasExpanded = true;
        }
      } else {
        imagePanel!.style.width = '100%';
        hasExpanded = true;
      }
    }

    ScrollTrigger.create({
      trigger: section,
      start: 'top 55%',
      end: 'top 15%',
      scrub: true,
      onUpdate: (self) => updateInitialExpand(self.progress),
    });

    // Normal smooth carousel playback across all filtered images
    function tick(now: number) {
      if (isVisible && !isPaused && filteredIndices.length > 1) {
        if (now - autoStart >= AUTO_MS) {
          stepCarousel(1);
        }
        if (progressBar) {
          progressBar.style.width = `${Math.min(100, ((now - autoStart) / AUTO_MS) * 100)}%`;
        }
      } else {
        autoStart = now;
      }
      requestAnimationFrame(tick);
    }

    prevBtn?.addEventListener('click', () => stepCarousel(-1));
    nextBtn?.addEventListener('click', () => stepCarousel(1));

    thumbBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.dataset.thumbIdx || '0');
        showSlide(idx);
      });
    });

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeFilter = (btn.dataset.diningFilter as typeof activeFilter) || 'all';
        applyFilters();
      });
    });

    islandPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        activeIsland = (pill.dataset.diningIsland as typeof activeIsland) || 'all';
        applyFilters();
      });
    });

    imagePanel.addEventListener('mouseenter', () => { isPaused = true; });
    imagePanel.addEventListener('mouseleave', () => { isPaused = false; });

    let touchStartX = 0;
    imagePanel.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
      isPaused = true;
    }, { passive: true });
    imagePanel.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) > 40) stepCarousel(dx < 0 ? 1 : -1);
      isPaused = false;
    }, { passive: true });

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          isVisible = entries.some((e) => e.isIntersecting);
          if (isVisible) {
            autoStart = performance.now();
          }
        },
        { threshold: 0.05 }
      );
      io.observe(section);
    } else {
      isVisible = true;
    }

    updateCaptionAndThumbs(0);
    requestAnimationFrame(tick);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDiningSection);
  } else {
    initDiningSection();
  }
</script>
