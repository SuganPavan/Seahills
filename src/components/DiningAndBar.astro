---
import fs from 'node:fs';
import path from 'node:path';
import crypto from 'node:crypto';

const sourceFolders = [
  {
    key: '01-hl-candle',
    island: 'havelock',
    filter: 'dining',
    place: 'Havelock Island · Beachside & Poolside Candlelight',
    title: 'Romantic Candlelight Dining & Evening Bonfire',
    description:
      'Private candlelit tables on Shyam Nagar’s tranquil shores and poolside setups with freshly caught Andaman seafood and coastal delicacies.',
    dir: 'D:\\Sea_shell\\Havelock_CandlelightDinner',
  },
  {
    key: '02-hl-rest',
    island: 'havelock',
    filter: 'dining',
    place: 'Havelock Island · Kramuka Restaurant (50–80 Pax)',
    title: 'Kramuka — Multi-Cuisine Fine Dining & Zriya Banquet',
    description:
      'Kramuka Multi-Cuisine Fine Dining (50–80 Pax) serving Indian, Continental, Chinese & local Andaman flavours, alongside Zriya Banquet Hall (1150 Sq. Ft., up to 80 Pax).',
    dir: 'D:\\Sea_shell\\Havelock_restarent',
  },
  {
    key: '03-pb-candle',
    island: 'portblair',
    filter: 'dining',
    place: 'Port Blair · Cleopatra Restaurant (30–50 Pax)',
    title: 'Cleopatra — Egyptian-Heritage Multi-Cuisine Dining',
    description:
      'Inspired by Egyptian heritage with friezes & sculpture emboss at Sea Hills Hotel Port Blair (30–50 Pax), convertible into a Conference Hall on request.',
    dir: 'D:\\Sea_shell\\Candle_light',
  },
  {
    key: '04-pb-bar',
    island: 'portblair',
    filter: 'bar',
    place: 'Port Blair · Anubis Rooftop Lounge Bar',
    title: 'Anubis Rooftop Lounge Bar — Scenic Port Blair Overview',
    description:
      'Rooftop Lounge Bar offering a stunning overview of Port Blair city with premium cocktails, fine spirits, and a relaxing evening ambience.',
    dir: 'D:\\Sea_shell\\Bar',
  },
  {
    key: '05-pb-rec',
    island: 'portblair',
    filter: 'reception',
    place: 'Sea Hills · Grand Reception, Zriya & Conference',
    title: '24/7 Concierge, Zriya Banquet & Conference Facilities',
    description:
      'Gracious 24/7 Andaman hospitality, Zriya Banquet Hall at Havelock (1150 Sq. Ft. · Theatre 70–80 Pax / Cluster 50–60 Pax), and Port Blair Conference Hall.',
    dir: 'D:\\Sea_shell\\reception',
  },
];

const targetDir = path.join(process.cwd(), 'public', 'images', 'dining-scroll');
const imageExtRe = /\.(webp|jpe?g|png|avif)$/i;

interface DiningSlide {
  src: string;
  island: 'havelock' | 'portblair';
  filter: 'dining' | 'bar' | 'reception';
  place: string;
  title: string;
  description: string;
}

let slides: DiningSlide[] = [];
const hasLocalSources = sourceFolders.some((s) => fs.existsSync(s.dir));

if (hasLocalSources) {
  fs.mkdirSync(targetDir, { recursive: true });
  for (const oldFile of fs.readdirSync(targetDir)) {
    fs.unlinkSync(path.join(targetDir, oldFile));
  }

  const seenHashes = new Set<string>();
  const seenNames = new Set<string>();
  const seenStems = new Set<string>();

  const normalizeStem = (filename: string) =>
    path
      .parse(filename)
      .name.toLowerCase()
      .replace(/\s*\(\d+\)\s*$/i, '')
      .replace(/[\s_-]*(copy|duplicate|edited)(\s*\d*)?$/i, '')
      .trim();

  for (const folder of sourceFolders) {
    if (!fs.existsSync(folder.dir)) continue;
    const files = fs
      .readdirSync(folder.dir)
      .filter((f) => imageExtRe.test(f))
      .sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }));

    let idx = 1;
    for (const file of files) {
      const srcPath = path.join(folder.dir, file);
      if (!fs.statSync(srcPath).isFile()) continue;

      const buf = fs.readFileSync(srcPath);
      const hash = crypto.createHash('md5').update(buf).digest('hex');
      const normName = file.toLowerCase();
      const stem = normalizeStem(file);

      if (seenHashes.has(hash) || seenNames.has(normName) || (stem && seenStems.has(stem))) continue;
      seenHashes.add(hash);
      seenNames.add(normName);
      if (stem) seenStems.add(stem);

      const ext = path.extname(file).toLowerCase();
      const outName = `${folder.key}-${String(idx).padStart(2, '0')}${ext}`;
      fs.writeFileSync(path.join(targetDir, outName), buf);
      slides.push({
        src: `/images/dining-scroll/${outName}`,
        island: folder.island as 'havelock' | 'portblair',
        filter: folder.filter as 'dining' | 'bar' | 'reception',
        place: folder.place,
        title: folder.title,
        description: folder.description,
      });
      idx++;
    }
  }
} else if (fs.existsSync(targetDir)) {
  const files = fs
    .readdirSync(targetDir)
    .filter((f) => imageExtRe.test(f))
    .sort();

  slides = files.map((f) => {
    const matched = sourceFolders.find((sf) => f.startsWith(sf.key)) || sourceFolders[0];
    return {
      src: `/images/dining-scroll/${f}`,
      island: matched.island as 'havelock' | 'portblair',
      filter: matched.filter as 'dining' | 'bar' | 'reception',
      place: matched.place,
      title: matched.title,
      description: matched.description,
    };
  });
}

if (slides.length === 0) {
  slides = [
    {
      src: '/images/facilities/restaurant.jpg',
      island: 'havelock',
      filter: 'dining',
      place: sourceFolders[0].place,
      title: sourceFolders[0].title,
      description: sourceFolders[0].description,
    },
    {
      src: '/images/facilities/bar.jpg',
      island: 'portblair',
      filter: 'bar',
      place: sourceFolders[3].place,
      title: sourceFolders[3].title,
      description: sourceFolders[3].description,
    },
    {
      src: '/images/facilities/pool-bright.jpg',
      island: 'portblair',
      filter: 'reception',
      place: sourceFolders[4].place,
      title: sourceFolders[4].title,
      description: sourceFolders[4].description,
    },
  ];
}
---

<section
  id="dining-bar-banner"
  class="relative bg-[#101416] text-[#F5F1E8] border-t border-white/5 py-10 sm:py-14 overflow-hidden"
  data-slides={JSON.stringify(slides)}
>
  <div class="relative w-full flex flex-col justify-center px-3 sm:px-6 lg:px-8">
