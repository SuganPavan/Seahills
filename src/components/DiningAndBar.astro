    ></div>

    <div class="relative z-10 w-full max-w-[1440px] mx-auto">

      <!-- SECTION HEADING -->
      <header class="text-center max-w-3xl mx-auto mb-6">
        <div class="flex items-center justify-center gap-3 sm:gap-5 mb-2">
          <span class="w-10 sm:w-20 h-[1px] bg-gradient-to-r from-transparent via-[#D6B66C]/60 to-[#D6B66C]"></span>
