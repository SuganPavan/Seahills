---
// DiscoverAndaman.astro - SECTION 5: DISCOVER ANDAMAN (GOLDEN WAVE 5-CARD DESIGN + 3 UPLOADED VIDEOS)
// Top & Bottom flowing champagne-gold SVG waves framing a symmetrical 5-card wave layout:
//   01 Underwater World (Image) | 02 Island Escapes (Image) | 03 Sea Shell Resort Tour (Video - Peak Most Popular)
//   04 Jet Ski · Elephant Beach (Video) | 05 Island Dinner Cruise (Video)
// Palette: Champagne Gold (#D6B66C), Luminous Gold (#F3E7C4), Midnight Black (#101416), Soft Ivory (#F5F1E8)
import fs from 'node:fs';
import path from 'node:path';

const videoDir = path.join(process.cwd(), 'public', 'video');
let uploadedVideos: { file: string; src: string }[] = [];
if (fs.existsSync(videoDir)) {
  uploadedVideos = fs
    .readdirSync(videoDir)
    .filter((f) => /\.(mp4|webm|mov|m4v)$/i.test(f) && !/resort[-_\s]?tour/i.test(f))
    .sort()
    .map((f) => ({
      file: f.toLowerCase(),
      src: `/video/${encodeURIComponent(f)}`
    }));
}

const EXPERIENCE_SLOTS = [
  {
    num: '01',
    title: 'Underwater World',
    desc: 'Explore vibrant coral reefs and marine life.',
    poster: '/images/facilities/experiences.jpg',
    keywords: ['underwater', 'scuba', 'dive', 'reef'],
    featured: false,
    waveClass: 'lg:-translate-y-1',
    videoScale: 'scale-105'
  },
  {
    num: '02',
    title: 'Sea Walk',
    desc: 'Walk along the ocean floor surrounded by tropical coral reefs.',
    poster: '/images/facilities/pool-bright.jpg',
    keywords: ['sea_walk', 'seawalk', 'sea-walk', 'walk'],
    featured: false,
    waveClass: 'lg:translate-y-5',
    videoScale: 'scale-110'
  },
  {
    num: '03',
    title: 'Parasailing',
    desc: 'Soar high above turquoise Andaman waters with breathtaking island views.',
    poster: '/frames/Destination/frame_0061.webp',
    keywords: ['paradising', 'parasailing', 'parasail', 'para'],
    featured: true,
    waveClass: 'lg:-translate-y-5',
    videoScale: 'scale-110'
  },
  {
    num: '04',
    title: 'Jet Ski · Elephant Beach',
    desc: 'Experience thrilling jet skiing and water sports across turquoise lagoons.',
    poster: '/images/facilities/dining.jpg',
    keywords: ['jet', 'ski', 'elephenta', 'elephanta'],
    featured: false,
    waveClass: 'lg:translate-y-5',
    videoScale: 'scale-115'
  },
  {
    num: '05',
    title: 'Island Dinner Cruise',
    desc: 'Sail into golden twilight with an unforgettable Andaman dinner cruise.',
    poster: '/images/facilities/events.jpg',
    keywords: ['dinner', 'cruise'],
    featured: false,
    waveClass: 'lg:-translate-y-1',
    videoScale: 'scale-[1.38]'
  }
];

const usedVideoSrcs = new Set<string>();
const assignedVideos: (string | null)[] = EXPERIENCE_SLOTS.map((slot) => {
  const match = uploadedVideos.find(
    (v) => !usedVideoSrcs.has(v.src) && slot.keywords.some((kw) => v.file.includes(kw))
  );
  if (match) {
    usedVideoSrcs.add(match.src);
    return match.src;
  }
  return null;
});

const cards = EXPERIENCE_SLOTS.map((slot, idx) => ({
  ...slot,
  videoSrc: assignedVideos[idx]
}));
---

<section id="island-experiences-banner" class="relative w-full lg:min-h-[88vh] flex flex-col justify-center bg-[#101416] py-14 sm:py-18 overflow-hidden z-20">

  <!-- Ambient Champagne Gold Radial Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[860px] h-[540px] bg-gradient-radial from-[#D6B66C]/12 via-[#D6B66C]/4 to-transparent rounded-full blur-3xl pointer-events-none"></div>

  <!-- TOP FLOWING GOLDEN WAVE SVG -->
  <div class="w-full overflow-hidden pointer-events-none mb-4 sm:mb-6 opacity-85" aria-hidden="true">
    <svg class="w-full h-10 sm:h-14" viewBox="0 0 1440 70" preserveAspectRatio="none" fill="none">
      <defs>
        <linearGradient id="discover-gold-wave-top" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#D6B66C" stop-opacity="0" />
          <stop offset="25%" stop-color="#D6B66C" stop-opacity="0.7" />
          <stop offset="50%" stop-color="#FFF3D6" stop-opacity="1" />
          <stop offset="75%" stop-color="#D6B66C" stop-opacity="0.7" />
          <stop offset="100%" stop-color="#D6B66C" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path d="M0,45 C240,8 480,68 720,28 C960,-10 1200,62 1440,30" stroke="url(#discover-gold-wave-top)" stroke-width="1.6" />
      <path d="M0,55 C280,22 520,72 760,36 C1000,2 1220,66 1440,42" stroke="url(#discover-gold-wave-top)" stroke-width="0.75" stroke-opacity="0.55" />
    </svg>
  </div>

  <div class="relative w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- SECTION HEADER -->
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12 select-none">
      <div class="flex items-center justify-center gap-3 mb-2.5">
        <span class="w-8 sm:w-14 h-[1px] bg-gradient-to-r from-transparent to-[#D6B66C]"></span>
        <span class="text-[10px] sm:text-[11px] tracking-[0.28em] uppercase font-sans font-semibold text-transparent bg-clip-text bg-gradient-to-r from-[#D6B66C] via-[#FFF3D6] to-[#D6B66C]">
          DISCOVER ANDAMAN
        </span>
        <span class="w-8 sm:w-14 h-[1px] bg-gradient-to-l from-transparent to-[#D6B66C]"></span>
      </div>
      <h2 class="font-cormorant text-3xl sm:text-4xl lg:text-[44px] font-normal text-[#F5F1E8] leading-[1.12] tracking-[0.015em] drop-shadow-sm">
        An Archipelago of Extraordinary Experiences
      </h2>
    </div>

    <!-- 5-CARD GOLDEN WAVE COMPOSITION -->
    <div id="discover-cards-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 sm:gap-5 items-center pt-4 pb-8">
      {cards.map((card, idx) => (
        <article
          class={`discover-exp-card group relative rounded-2xl overflow-hidden bg-[#101416] transition-all duration-500 ease-out cursor-pointer ${card.waveClass} ${
            card.featured
              ? 'h-[360px] sm:h-[380px] lg:h-[405px] border-2 border-[#D6B66C] shadow-[0_24px_60px_rgba(0,0,0,0.85),0_0_32px_rgba(214,182,108,0.3)] z-20'
              : 'h-[330px] sm:h-[350px] lg:h-[370px] border border-[#D6B66C]/40 hover:border-[#D6B66C] shadow-[0_16px_42px_rgba(0,0,0,0.7)] hover:shadow-[0_22px_52px_rgba(214,182,108,0.28)] hover:-translate-y-2 z-10'
          }`}
          data-card-index={idx}
          data-has-video={card.videoSrc ? 'true' : 'false'}
        >
          <!-- Center Featured Pill -->
          {card.featured && (
            <div class="absolute top-3 left-1/2 -translate-x-1/2 z-30 px-3 py-0.5 rounded-full bg-gradient-to-r from-[#D6B66C] via-[#F3E7C4] to-[#D6B66C] text-[#101416] text-[9.5px] font-sans font-bold uppercase tracking-[0.16em] shadow-md whitespace-nowrap">
              Most Popular
            </div>
          )}

          <!-- Live Video (cropped clean) OR Related High-Res Experience Image -->
          {card.videoSrc ? (
            <video
              data-src={card.videoSrc}
              poster={card.poster}
              class={`discover-card-video absolute inset-0 w-full h-full object-cover object-center transform ${card.videoScale} group-hover:scale-125 transition-transform duration-700 ease-out`}
              muted
              loop
              playsinline
              preload="none"
            ></video>
          ) : (
            <img
              src={card.poster}
              alt={card.title}
              class="absolute inset-0 w-full h-full object-cover object-center transform scale-100 group-hover:scale-110 transition-transform duration-700 ease-out"
              loading="lazy"
              decoding="async"
            />
          )}

          <!-- Subtle Top & Bottom Dark Gradient for Crisp Typography -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#0B0E10] via-[#0B0E10]/40 to-transparent pointer-events-none z-10"></div>

          <!-- Top-Right Live Video Indicator Badge (Non-featured cards only) -->
          {card.videoSrc && !card.featured && (
            <div class="absolute top-3 right-3 z-20 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#101416]/75 backdrop-blur-md border border-[#D6B66C]/45">
              <span class="w-1.5 h-1.5 rounded-full bg-[#D6B66C] animate-pulse"></span>
              <span class="text-[9px] uppercase tracking-[0.16em] text-[#F5F1E8] font-sans font-medium">Video</span>
            </div>
          )}

          <!-- Card Content Overlay -->
          <div class="absolute inset-x-0 bottom-0 p-4 sm:p-5 z-20 flex items-end justify-between gap-2">
            <div class="min-w-0">
              <span class="block text-xs font-mono font-semibold tracking-[0.18em] text-[#D6B66C] mb-1">
                {card.num}
              </span>
              <h3 class="font-cormorant text-xl sm:text-[22px] font-medium text-[#F5F1E8] leading-tight mb-1 group-hover:text-[#F3E7C4] transition-colors">
                {card.title}
              </h3>
              <p class="text-[11px] sm:text-[11.5px] text-[#C8BFAE] font-light leading-snug line-clamp-2">
                {card.desc}
              </p>
            </div>

            <!-- Bottom-Right Circular Gold '+' Action Button -->
            <a
              href="#experiences"
              aria-label={`Explore ${card.title}`}
              class="flex-shrink-0 w-8 h-8 rounded-full border border-[#D6B66C]/60 bg-[#101416]/70 text-[#D6B66C] group-hover:bg-[#D6B66C] group-hover:text-[#101416] flex items-center justify-center transition-all duration-300 shadow-md"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- VIEW ALL ACTIVITIES CTA BUTTON -->
    <div class="mt-8 sm:mt-10 flex justify-center">
      <a
        href="#experiences"
        id="discover-view-all-btn"
        class="inline-flex items-center gap-2.5 px-6 sm:px-7 py-2.5 sm:py-3 rounded-full border border-[#D6B66C]/60 bg-[#101416]/85 text-[#D6B66C] hover:bg-[#D6B66C] hover:text-[#101416] transition-all duration-300 text-[11px] sm:text-xs uppercase tracking-[0.18em] font-sans font-semibold shadow-[0_8px_24px_rgba(0,0,0,0.45)] hover:shadow-[0_6px_22px_rgba(214,182,108,0.4)] group/all"
      >
        <span>View All Activities</span>
        <svg class="w-4 h-4 transition-transform duration-300 group-hover/all:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

  </div>

  <!-- BOTTOM FLOWING GOLDEN WAVE SVG -->
  <div class="w-full overflow-hidden pointer-events-none mt-4 sm:mt-6 opacity-85" aria-hidden="true">
    <svg class="w-full h-10 sm:h-14" viewBox="0 0 1440 70" preserveAspectRatio="none" fill="none">
      <defs>
        <linearGradient id="discover-gold-wave-bottom" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#D6B66C" stop-opacity="0" />
          <stop offset="25%" stop-color="#D6B66C" stop-opacity="0.7" />
          <stop offset="50%" stop-color="#FFF3D6" stop-opacity="1" />
          <stop offset="75%" stop-color="#D6B66C" stop-opacity="0.7" />
          <stop offset="100%" stop-color="#D6B66C" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path d="M0,25 C240,62 480,2 720,42 C960,80 1200,8 1440,40" stroke="url(#discover-gold-wave-bottom)" stroke-width="1.6" />
      <path d="M0,15 C280,48 520,-2 760,34 C1000,68 1220,4 1440,28" stroke="url(#discover-gold-wave-bottom)" stroke-width="0.75" stroke-opacity="0.55" />
    </svg>
  </div>
</section>

<script>
  if (typeof window !== 'undefined') {
    const section = document.getElementById('island-experiences-banner');
    const cardVideos = Array.from(document.querySelectorAll('.discover-card-video')) as HTMLVideoElement[];

    if (section && cardVideos.length > 0) {
      let videosHydrated = false;
      const hydrateVideos = () => {
        if (videosHydrated) return;
        videosHydrated = true;
        cardVideos.forEach((v) => {
          const ds = v.dataset.src;
          if (ds && !v.src) {
            v.src = ds;
            v.muted = true;
            v.playsInline = true;
            v.load();
          }
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              hydrateVideos();
              cardVideos.forEach((v) => v.play().catch(() => {}));
            } else {
              cardVideos.forEach((v) => {
                if (!v.paused) v.pause();
              });
            }
          });
        },
        { rootMargin: '600px 0px', threshold: 0.05 }
      );
      observer.observe(section);
    }
  }
</script>
