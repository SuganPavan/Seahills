---
---

<section
  id="book-now"
  class="relative bg-[#071115] text-[#F5F1E8] pt-10 pb-10 px-4 sm:px-8 lg:px-12 overflow-hidden"
>
  <!-- Top Champagne Gold Wave Divider -->
  <div class="pointer-events-none absolute top-0 inset-x-0 w-full overflow-hidden leading-none z-20">
    <svg viewBox="0 0 1440 36" fill="none" class="w-full h-7 sm:h-8" preserveAspectRatio="none">
      <path d="M0 18 Q 360 36 720 14 T 1440 18" stroke="url(#book-wave-top)" stroke-width="1.5" fill="none" />
      <defs>
        <linearGradient id="book-wave-top" x1="0" y1="0" x2="1440" y2="0" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#D6B66C" stop-opacity="0.1" />
          <stop offset="50%" stop-color="#F3E7C4" stop-opacity="0.8" />
          <stop offset="100%" stop-color="#D6B66C" stop-opacity="0.1" />
        </linearGradient>
      </defs>
    </svg>
  </div>

  <!-- Split Background Photography (Port Blair Left / Havelock Right) -->
  <div class="pointer-events-none absolute inset-0 grid grid-cols-1 md:grid-cols-2">
    <div class="relative overflow-hidden">
      <img src="/frames/Home_Section/frame_0025.webp" alt="Sea Hills Port Blair" class="w-full h-full object-cover opacity-80" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#071115]/40 via-[#071115]/25 to-[#071115]/60"></div>
    </div>
    <div class="relative overflow-hidden">
      <img src="/images/facilities/pool-bright.jpg" alt="Sea Hills Havelock Island" class="w-full h-full object-cover opacity-80" />
      <div class="absolute inset-0 bg-gradient-to-l from-[#071115]/40 via-[#071115]/25 to-[#071115]/60"></div>
    </div>
  </div>
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-[#071115]/55 via-transparent to-[#071115]/70"></div>

  <div class="relative z-10 max-w-[1320px] mx-auto pt-2">
    <!-- Top Header -->
    <div class="text-center max-w-4xl mx-auto mb-7">
      <p class="text-[10px] uppercase tracking-[0.28em] text-[#D6B66C] font-semibold mb-1.5">
        Your Island Story Starts Here
      </p>
      <h2 class="font-cormorant text-3xl sm:text-[2.75rem] text-[#F5F1E8] font-normal leading-tight">
        Two Destinations. <span class="text-[#F3E7C4] italic">One Unforgettable Stay.</span>
      </h2>
    </div>

    <!-- Center Floating Sandle Booking Card Flanked by Port Blair & Havelock Info -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <!-- Left Property Callout: Port Blair (3 Cols) -->
      <div class="lg:col-span-3 space-y-2.5 text-center lg:text-left">
        <p class="text-[11px] uppercase tracking-[0.22em] text-[#D6B66C] font-semibold flex items-center justify-center lg:justify-start gap-1.5">
          <span>📍</span> PORT BLAIR
        </p>
        <p class="font-cormorant italic text-2xl text-[#F5F1E8] leading-snug">
          City Comfort &amp; Island Connectivity
        </p>
        <a
          href="#rooms-suites-banner"
          class="inline-flex items-center gap-2 rounded-full border border-[#D6B66C]/60 bg-[#0D161B]/80 hover:bg-[#D6B66C] text-[#F3E7C4] hover:text-[#101416] px-5 py-2 text-[11px] font-semibold transition-all"
        >
          <span>Explore Property</span>
          <span>→</span>
        </a>
      </div>

      <!-- Center Sandle/Parchment Booking Card (6 Cols) -->
      <div class="lg:col-span-6 relative">
        <div class="relative rounded-2xl bg-gradient-to-br from-[#F7EBD3] via-[#EEDCB9] to-[#E2C99A] text-[#22190F] p-4 sm:p-5 shadow-[0_24px_65px_rgba(0,0,0,0.85)] border border-[#F8EED9]">
          <!-- Top Pill Title -->
          <div class="flex justify-center -mt-7 mb-3">
            <span class="rounded-full bg-[#3A2D1B] border border-[#D6B66C] text-[#F3E7C4] px-5 py-1 text-xs font-semibold tracking-wide shadow-lg">
              Choose Your Stay
            </span>
          </div>

          <!-- Property Toggle Buttons -->
          <div class="grid grid-cols-2 gap-3 mb-4">
            <button
              type="button"
              data-book-property="Port Blair"
              class="book-prop-btn rounded-xl px-4 py-3 text-sm font-semibold flex items-center justify-center gap-2 bg-gradient-to-r from-[#D6B66C] to-[#E7CA88] text-[#1A130B] shadow-md transition-all"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
              <span>Port Blair</span>
            </button>
            <button
              type="button"
              data-book-property="Havelock Island"
              class="book-prop-btn rounded-xl px-4 py-3 text-sm font-semibold flex items-center justify-center gap-2 bg-[#FAF3E4] text-[#3A2D1B] border border-[#C8B188] hover:border-[#8A6932] transition-all"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 15c2.483 0 4.345-1.5 6-1.5s3.517 1.5 6 1.5 3.517-1.5 6-1.5M3 19c2.483 0 4.345-1.5 6-1.5s3.517 1.5 6 1.5 3.517-1.5 6-1.5" />
              </svg>
              <span>Havelock Island</span>
            </button>
          </div>

          <!-- Date Inputs -->
          <form id="booking-quick-form" class="space-y-3">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <label class="block rounded-xl bg-[#FAF3E4] border border-[#C8B188] px-3.5 py-2">
                <span class="block text-[10px] uppercase tracking-wider text-[#6D583F]">Check In</span>
                <input
                  type="date"
                  id="book-checkin"
                  required
                  class="w-full bg-transparent text-xs font-medium text-[#22190F] focus:outline-none mt-0.5"
                />
              </label>

              <label class="block rounded-xl bg-[#FAF3E4] border border-[#C8B188] px-3.5 py-2">
                <span class="block text-[10px] uppercase tracking-wider text-[#6D583F]">Check Out</span>
                <input
                  type="date"
                  id="book-checkout"
                  required
                  class="w-full bg-transparent text-xs font-medium text-[#22190F] focus:outline-none mt-0.5"
                />
              </label>
            </div>

            <!-- Adults / Children / Rooms -->
            <div class="grid grid-cols-3 gap-2.5">
              <label class="block rounded-xl bg-[#FAF3E4] border border-[#C8B188] px-3 py-2">
                <span class="block text-[10px] uppercase tracking-wider text-[#6D583F]">Adults</span>
                <select id="book-adults" class="w-full bg-transparent text-xs font-semibold text-[#22190F] focus:outline-none mt-0.5">
                  <option value="1">1 Adult</option>
                  <option value="2" selected>2 Adults</option>
                  <option value="3">3 Adults</option>
                  <option value="4">4 Adults</option>
                </select>
              </label>

              <label class="block rounded-xl bg-[#FAF3E4] border border-[#C8B188] px-3 py-2">
                <span class="block text-[10px] uppercase tracking-wider text-[#6D583F]">Children</span>
                <select id="book-children" class="w-full bg-transparent text-xs font-semibold text-[#22190F] focus:outline-none mt-0.5">
                  <option value="0" selected>0 Children</option>
                  <option value="1">1 Child</option>
                  <option value="2">2 Children</option>
                </select>
              </label>

              <label class="block rounded-xl bg-[#FAF3E4] border border-[#C8B188] px-3 py-2">
                <span class="block text-[10px] uppercase tracking-wider text-[#6D583F]">Rooms</span>
                <select id="book-rooms" class="w-full bg-transparent text-xs font-semibold text-[#22190F] focus:outline-none mt-0.5">
                  <option value="1" selected>1 Room</option>
                  <option value="2">2 Rooms</option>
                  <option value="3">3 Rooms</option>
                </select>
              </label>
            </div>

            <button
              type="submit"
              id="check-availability-btn"
              class="w-full rounded-full bg-gradient-to-r from-[#D6B66C] to-[#E6C987] hover:from-[#c4a254] hover:to-[#d9b86c] text-[#1A130B] py-3.5 text-xs uppercase tracking-[0.18em] font-bold shadow-[0_10px_28px_rgba(140,104,38,0.35)] transition-all flex items-center justify-center gap-2"
            >
              <span>Check Availability</span>
              <span>→</span>
            </button>

            <p id="booking-status-msg" class="hidden text-center text-xs font-medium text-[#2A5934] bg-[#E3F1E5] border border-[#96C79F] rounded-lg px-3 py-2"></p>
          </form>
        </div>
      </div>

      <!-- Right Property Callout: Havelock Island (3 Cols) -->
      <div class="lg:col-span-3 space-y-2.5 text-center lg:text-right">
        <p class="text-[11px] uppercase tracking-[0.22em] text-[#D6B66C] font-semibold flex items-center justify-center lg:justify-end gap-1.5">
          <span>📍</span> HAVELOCK ISLAND
        </p>
        <p class="font-cormorant italic text-2xl text-[#F5F1E8] leading-snug">
          Tropical Escape &amp; Island Serenity
        </p>
        <a
          href="#destinations-section"
          class="inline-flex items-center gap-2 rounded-full border border-[#D6B66C]/60 bg-[#0D161B]/80 hover:bg-[#D6B66C] text-[#F3E7C4] hover:text-[#101416] px-5 py-2 text-[11px] font-semibold transition-all"
        >
          <span>Explore Property</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- Bottom Complete Andaman Journey Banner -->
    <div class="mt-6 rounded-2xl border border-[#D6B66C]/50 bg-gradient-to-r from-[#0B171D] via-[#0E1E26] to-[#0B171D] p-2.5 sm:p-3 flex flex-col md:flex-row items-center justify-between gap-4 shadow-[0_18px_45px_rgba(0,0,0,0.65)]">
      <div class="flex items-center gap-4">
        <img
          src="/frames/Destination/frame_0001.webp"
          alt="Andaman Islands Aerial"
          class="w-32 sm:w-40 h-14 sm:h-16 object-cover rounded-xl border border-[#D6B66C]/35 flex-shrink-0"
        />
        <div>
          <div class="flex items-center gap-3">
            <h3 class="font-cormorant italic text-xl sm:text-2xl text-[#F3E7C4] leading-tight">
              Complete Andaman Journey
            </h3>
            <span class="hidden sm:inline-flex items-center gap-1.5 text-[#D6B66C] text-xs">
              <span class="w-8 border-b border-dashed border-[#D6B66C]/70"></span>
              <span>✈</span>
            </span>
          </div>
          <p class="text-xs text-[#C8BFAE] mt-0.5">
            Stay in Port Blair + Explore Havelock · reservation@seahillshotels.com
          </p>
        </div>
      </div>

      <a
        href="/packages"
        class="inline-flex items-center gap-2.5 rounded-full border border-[#D6B66C] bg-[#0B171D] hover:bg-[#D6B66C] text-[#F3E7C4] hover:text-[#101416] px-6 py-2 text-xs font-semibold tracking-wide transition-all whitespace-nowrap"
      >
        <span>Plan Your Trip</span>
        <span>→</span>
      </a>
    </div>
  </div>
</section>

<script>
  const propBtns = Array.from(document.querySelectorAll('.book-prop-btn')) as HTMLElement[];
  let selectedProperty = 'Port Blair';

  propBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      selectedProperty = btn.dataset.bookProperty || 'Port Blair';
      propBtns.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('bg-gradient-to-r', active);
        b.classList.toggle('from-[#D6B66C]', active);
        b.classList.toggle('to-[#E7CA88]', active);
        b.classList.toggle('text-[#1A130B]', active);
        b.classList.toggle('shadow-md', active);
        b.classList.toggle('bg-[#FAF3E4]', !active);
        b.classList.toggle('text-[#3A2D1B]', !active);
        b.classList.toggle('border', !active);
        b.classList.toggle('border-[#C8B188]', !active);
      });
    });
  });

  const form = document.getElementById('booking-quick-form') as HTMLFormElement | null;
  const statusMsg = document.getElementById('booking-status-msg');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const ci = (document.getElementById('book-checkin') as HTMLInputElement)?.value || '';
    const co = (document.getElementById('book-checkout') as HTMLInputElement)?.value || '';
    const adults = (document.getElementById('book-adults') as HTMLSelectElement)?.value || '2';
    const rooms = (document.getElementById('book-rooms') as HTMLSelectElement)?.value || '1';
    if (statusMsg) {
      statusMsg.textContent = `Request ready for Sea Hills ${selectedProperty} (${ci} to ${co}, ${adults} Adults, ${rooms} Room). Our desk at reservation@seahillshotels.com will confirm shortly.`;
      statusMsg.classList.remove('hidden');
    }
  });
</script>
