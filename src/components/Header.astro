---
// Header.astro - Refined Luxury Hospitality Header
// Palette: Champagne Gold (#D6B66C), Midnight Black (#101416), Soft Ivory (#F5F1E8), Warm Beige (#C8BFAE)
import MotionButton from './motion/MotionButton';
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 w-full transition-all duration-300">
  <!-- Subtle header gradient scrim strictly at the top bar for flawless legibility -->
  <div id="header-scrim" class="absolute inset-0 h-28 bg-gradient-to-b from-[#101416]/60 via-[#101416]/20 to-transparent pointer-events-none transition-opacity duration-300"></div>

  <div id="header-inner" class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-10 py-5 sm:py-6 transition-all duration-300">
    <div class="flex items-center justify-between">
      
      <!-- Brand Logo (Left) -->
      <a href="/" class="flex items-center gap-3.5 group no-underline text-[#F5F1E8] focus:outline-none select-none">
        <!-- Logo Crest: Elegant champagne gold hairline ring -->
        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-full border border-[#D6B66C]/60 bg-[#101416]/40 backdrop-blur-md flex items-center justify-center p-2 shadow-[0_4px_16px_rgba(0,0,0,0.3)] group-hover:border-[#D6B66C] transition-all duration-300 flex-shrink-0">
          <svg
            viewBox="0 0 40 40"
            class="w-6 h-6 text-[#D6B66C]"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <!-- Sun rays & palm silhouette -->
            <circle cx="20" cy="15" r="7" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 2" />
            <path d="M20 22 C20 29 18 34 16 35" stroke="currentColor" stroke-width="2" />
            <path d="M20 22 C14 18 10 20 8 23" stroke="currentColor" />
            <path d="M20 22 C16 15 13 16 11 18" stroke="currentColor" />
            <path d="M20 22 C26 18 30 20 32 23" stroke="currentColor" />
            <path d="M20 22 C24 15 27 16 29 18" stroke="currentColor" />
            <path d="M12 35 C17 34 23 34 28 35" stroke="currentColor" />
          </svg>
        </div>
        
        <!-- Wordmark with refined Cormorant typography -->
        <div class="flex flex-col text-left">
          <span class="font-cormorant text-2xl sm:text-[25px] font-normal tracking-[0.05em] text-[#F5F1E8] leading-none drop-shadow-sm group-hover:text-[#D6B66C] transition-colors">
            Sea Hills
          </span>
          <span class="text-[9px] tracking-[0.3em] font-medium text-[#C8BFAE] uppercase mt-1 drop-shadow-sm font-sans">
            Hotels & Resorts
          </span>
        </div>
      </a>

      <!-- Center Navigation Links -->
      <nav class="hidden lg:flex items-center space-x-8 text-[12px] tracking-[0.16em] uppercase font-light text-[#F5F1E8]/90 drop-shadow-sm">
        <a href="/" class="text-[#F5F1E8] font-medium hover:text-[#D6B66C] transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-full after:h-[1.5px] after:bg-[#D6B66C] after:scale-x-100 transition-all">
          Home
        </a>

        <!-- Destinations Dropdown -->
        <div class="relative group">
          <button class="flex items-center gap-1.5 hover:text-[#D6B66C] transition-colors py-2 focus:outline-none text-[#F5F1E8]/90 font-light tracking-[0.16em] uppercase">
            <span>Destinations</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180 text-[#D6B66C]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          
          <div class="absolute left-1/2 -translate-x-1/2 top-full mt-2 w-64 bg-[#101416]/95 backdrop-blur-xl border border-[#C8BFAE]/20 rounded-2xl p-2.5 shadow-2xl opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
            <a href="#destination-havelock" class="flex items-center justify-between px-3 py-2 rounded-xl text-[#F5F1E8]/90 hover:text-white hover:bg-white/10 transition-colors text-xs font-light">
              <span>Havelock Island</span>
              <span class="text-[10px] text-[#D6B66C] font-mono tracking-wider">Swaraj Dweep</span>
            </a>
            <a href="#destination-neil" class="flex items-center justify-between px-3 py-2 rounded-xl text-[#F5F1E8]/90 hover:text-white hover:bg-white/10 transition-colors text-xs font-light">
              <span>Neil Island</span>
              <span class="text-[10px] text-[#D6B66C] font-mono tracking-wider">Shaheed Dweep</span>
            </a>
            <a href="#destination-port-blair" class="flex items-center justify-between px-3 py-2 rounded-xl text-[#F5F1E8]/90 hover:text-white hover:bg-white/10 transition-colors text-xs font-light">
              <span>Port Blair</span>
              <span class="text-[10px] text-[#D6B66C] font-mono tracking-wider">Capital City</span>
            </a>
            <a href="#destination-baratang" class="flex items-center justify-between px-3 py-2 rounded-xl text-[#F5F1E8]/90 hover:text-white hover:bg-white/10 transition-colors text-xs font-light">
              <span>Baratang Island</span>
              <span class="text-[10px] text-[#D6B66C] font-mono tracking-wider">Limestone Caves</span>
            </a>
            <a href="#destination-ross" class="flex items-center justify-between px-3 py-2 rounded-xl text-[#F5F1E8]/90 hover:text-white hover:bg-white/10 transition-colors text-xs font-light">
              <span>Ross Island</span>
              <span class="text-[10px] text-[#D6B66C] font-mono tracking-wider">Heritage Ruins</span>
            </a>
            <a href="#destination-north-bay" class="flex items-center justify-between px-3 py-2 rounded-xl text-[#F5F1E8]/90 hover:text-white hover:bg-white/10 transition-colors text-xs font-light">
              <span>North Bay Island</span>
              <span class="text-[10px] text-[#D6B66C] font-mono tracking-wider">Coral Reefs</span>
            </a>
          </div>
        </div>

        <a href="#packages" class="hover:text-[#D6B66C] transition-colors py-1">Packages</a>
        <a href="#experiences" class="hover:text-[#D6B66C] transition-colors py-1">Experiences</a>
        <a href="#gallery" class="hover:text-[#D6B66C] transition-colors py-1">Gallery</a>
        <a href="#reviews" class="hover:text-[#D6B66C] transition-colors py-1">Reviews</a>
        <a href="#contact" class="hover:text-[#D6B66C] transition-colors py-1">Contact</a>
      </nav>

      <!-- Right Action CTA (Book Now Button with champagne-gold styling) -->
      <div class="hidden sm:flex items-center">
        <MotionButton client:load href="#book-now" variant="gold" className="!px-5 !py-2.5 !text-[11px] !tracking-[0.18em]">
          <span>Book Now</span>
          <svg class="w-3 h-3 text-[#101416]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </MotionButton>
      </div>

      <!-- Mobile Compact Book Now + Hamburger Button -->
      <div class="flex lg:hidden items-center gap-2">
        <a
          href="#book-now"
          class="sm:hidden inline-flex items-center gap-1 px-3.5 py-1.5 rounded-full bg-[#D6B66C] text-[#101416] text-[10px] font-semibold uppercase tracking-[0.14em] shadow-md no-underline"
        >
          Book Now
        </a>
        <button
          id="mobile-menu-toggle"
          aria-label="Toggle Navigation Menu"
          class="p-2 text-[#F5F1E8] hover:bg-white/10 rounded-full focus:outline-none transition-colors"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden px-4 pb-4">
    <div class="bg-[#101416]/95 backdrop-blur-xl border border-[#C8BFAE]/20 rounded-2xl p-5 shadow-2xl flex flex-col space-y-3 text-[#F5F1E8]">
      <a href="/" class="text-[#D6B66C] font-medium py-1">Home</a>
      <div class="space-y-1.5 pl-3 border-l border-[#D6B66C]/40 text-sm">
        <a href="#destination-havelock" class="block text-[#C8BFAE] hover:text-white">Havelock Island</a>
        <a href="#destination-neil" class="block text-[#C8BFAE] hover:text-white">Neil Island</a>
        <a href="#destination-port-blair" class="block text-[#C8BFAE] hover:text-white">Port Blair</a>
        <a href="#destination-baratang" class="block text-[#C8BFAE] hover:text-white">Baratang Island</a>
        <a href="#destination-ross" class="block text-[#C8BFAE] hover:text-white">Ross Island</a>
        <a href="#destination-north-bay" class="block text-[#C8BFAE] hover:text-white">North Bay Island</a>
      </div>
      <a href="#packages" class="text-[#F5F1E8]/90 hover:text-[#D6B66C] py-1">Packages</a>
      <a href="#experiences" class="text-[#F5F1E8]/90 hover:text-[#D6B66C] py-1">Experiences</a>
      <a href="#gallery" class="text-[#F5F1E8]/90 hover:text-[#D6B66C] py-1">Gallery</a>
      <a href="#reviews" class="text-[#F5F1E8]/90 hover:text-[#D6B66C] py-1">Reviews</a>
      <a href="#contact" class="text-[#F5F1E8]/90 hover:text-[#D6B66C] py-1">Contact</a>
      <div class="pt-2">
        <a
          href="#book-now"
          class="w-full flex items-center justify-center gap-1.5 py-2.5 rounded-full bg-[#D6B66C] text-[#101416] font-medium text-xs tracking-wider uppercase shadow-md no-underline"
        >
          <span>Book Now</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const headerInner = document.getElementById('header-inner');
  const headerScrim = document.getElementById('header-scrim');
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  function updateHeaderOnScroll() {
    const scrolled = window.scrollY > 40;
    if (header) {
      header.classList.toggle('bg-[#0B1115]/88', scrolled);
      header.classList.toggle('backdrop-blur-xl', scrolled);
      header.classList.toggle('border-b', scrolled);
      header.classList.toggle('border-[#D6B66C]/20', scrolled);
      header.classList.toggle('shadow-[0_8px_30px_rgba(0,0,0,0.45)]', scrolled);
    }
    if (headerInner) {
      headerInner.classList.toggle('py-5', !scrolled);
      headerInner.classList.toggle('sm:py-6', !scrolled);
      headerInner.classList.toggle('py-3', scrolled);
      headerInner.classList.toggle('sm:py-3.5', scrolled);
    }
    if (headerScrim) {
      headerScrim.classList.toggle('opacity-0', scrolled);
    }
  }

  window.addEventListener('scroll', updateHeaderOnScroll, { passive: true });
  updateHeaderOnScroll();

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }
</script>
