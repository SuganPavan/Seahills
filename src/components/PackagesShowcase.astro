---
---

<section
  id="packages"
  class="relative bg-[#071116] text-[#F5F1E8] overflow-hidden select-none"
>
  <!-- =========================================================================
       SCENIC SUNSET RESORT & INFINITY POOL HERO STAGE (Matches Reference Design)
       ========================================================================= -->
  <div class="relative min-h-[600px] lg:min-h-[650px] flex flex-col justify-between pt-10 sm:pt-12 pb-10 px-4 sm:px-8 lg:px-14">
    <!-- Full-Bleed Scenic Resort & Ocean Sunset Backdrop -->
    <div class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
      <img
        src="/images/facilities/pool-bright.jpg"
        alt="Sea Hills Luxury Resort Infinity Pool & Andaman Sunset"
        loading="lazy"
        class="w-full h-full object-cover object-center scale-105 opacity-55"
      />
      <!-- Sunset Golden Horizon Glow (Center-Left to Center) -->
      <div
        class="absolute inset-0"
        style="background:
          radial-gradient(ellipse 52% 40% at 48% 36%, rgba(245, 178, 92, 0.34) 0%, rgba(214, 150, 74, 0.14) 45%, transparent 75%),
          linear-gradient(90deg, rgba(6, 17, 23, 0.92) 0%, rgba(8, 23, 30, 0.72) 42%, rgba(9, 24, 31, 0.45) 72%, rgba(6, 16, 21, 0.82) 100%),
          linear-gradient(180deg, rgba(7, 17, 22, 0.85) 0%, rgba(7, 17, 22, 0.2) 38%, rgba(7, 18, 24, 0.78) 78%, rgba(7, 17, 22, 0.98) 100%);"
      ></div>
    </div>

    <!-- Top Row: Compact Left-Aligned Single-Line Title + Right-Aligned Explore Packages CTA -->
    <div class="relative z-20 max-w-[1340px] w-full mx-auto flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <!-- Left Editorial Copy (Single-Line Title + Subtitle) -->
      <div class="max-w-3xl space-y-1.5 text-left">
        <!-- Eyebrow with Flanking Gold Lines -->
        <div class="flex items-center justify-start gap-2.5">
          <span class="inline-block w-6 h-[1px] bg-gradient-to-r from-transparent to-[#D6B66C]"></span>
          <span class="text-[9.5px] sm:text-[10px] uppercase tracking-[0.28em] text-[#E5C985] font-semibold">
            LUXURY STAYS IN ANDAMAN
          </span>
          <span class="inline-block w-6 h-[1px] bg-gradient-to-l from-transparent to-[#D6B66C]"></span>
        </div>

        <!-- Single-Line Display Title -->
        <h2 class="font-cormorant text-2xl sm:text-3xl lg:text-[2.35rem] leading-tight text-[#F5F1E8] font-normal tracking-tight sm:whitespace-nowrap drop-shadow-[0_4px_20px_rgba(0,0,0,0.65)]">
          Not Just a Stay. <span class="text-[#E8C882] italic font-normal">An Island Journey.</span>
        </h2>

        <!-- Compact Subtitle -->
        <p class="text-xs sm:text-[13.5px] text-[#DCD5C7] font-light leading-relaxed max-w-lg drop-shadow-[0_2px_10px_rgba(0,0,0,0.75)]">
          Discover handpicked holiday packages for your perfect Andaman experience.
        </p>
      </div>

      <!-- Right-Aligned Glowing Gold Pill CTA Button -->
      <div class="flex items-center sm:justify-end flex-shrink-0">
        <a
          id="view-all-packages-btn"
          href="/packages"
          class="group relative inline-flex items-center gap-2.5 rounded-full border border-[#E5C985]/85 bg-[#0B1920]/85 hover:bg-gradient-to-r hover:from-[#D6B66C] hover:to-[#E8CD8E] text-[#F5F1E8] hover:text-[#101416] px-6 py-2.5 text-xs tracking-[0.06em] font-medium shadow-[0_0_24px_rgba(214,182,108,0.32),inset_0_1px_0_rgba(255,243,214,0.35)] transition-all duration-300 no-underline [text-shadow:none]"
        >
          <span>Explore Packages</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
          <!-- Subtle Bottom Gold Rim Flare -->
          <span class="pointer-events-none absolute -bottom-1 left-1/2 -translate-x-1/2 w-16 h-1 rounded-full bg-[#F3E7C4]/70 blur-[2px]"></span>
        </a>
      </div>
    </div>

    <!-- =======================================================================
         THREE HORIZONTAL DESTINATION PACKAGE CARDS (Matches Reference Image)
         1. Havelock Island (Pristine Beaches)
         2. Complete Island Journey (Most Popular · Elevated Center Card)
         3. Port Blair (The Gateway)
         ======================================================================= -->
    <div class="relative z-20 max-w-[1340px] w-full mx-auto mt-6 lg:mt-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-6 items-end">
        <!-- CARD 1 (LEFT): HAVELOCK ISLAND · PRISTINE BEACHES -->
        <article class="pkg-snake-card pkg-snake-float-1 lg:col-span-4 group relative rounded-[22px] overflow-hidden border border-[#D6B66C]/60 hover:border-[#FFF3D6] bg-[#0B181F] h-[250px] sm:h-[265px] shadow-[0_22px_55px_rgba(0,0,0,0.75)] transition-colors duration-500">
          <a href="/packages#havelock-pristine-beach-retreat" class="block w-full h-full relative no-underline">
            <img
              src="/frames/Destination/frame_0055.webp"
              alt="Sea Hills Resort Havelock Island Pristine Beaches"
              loading="lazy"
              class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#061015]/95 via-[#061015]/35 to-transparent"></div>

            <!-- Top-Left Authentic PDF Quick Pills -->
            <div class="absolute top-3.5 left-3.5 right-3.5 flex flex-wrap items-center justify-between gap-1.5">
              <span class="rounded-full bg-[#081319]/80 backdrop-blur-md border border-[#D6B66C]/50 px-3 py-1 text-[9.5px] uppercase tracking-[0.16em] text-[#F3E7C4] font-semibold">
                Swaraj Dweep · 40 Rooms (410 Sq Ft)
              </span>
              <span class="rounded-full bg-[#081319]/80 backdrop-blur-md border border-white/15 px-2.5 py-1 text-[9.5px] text-[#E5DFD2]">
                Ferry: 1.5 – 2.5 Hrs
              </span>
            </div>

            <!-- Bottom Content + Circular Arrow Button -->
            <div class="absolute inset-x-4 sm:inset-x-5 bottom-4 sm:bottom-5 flex items-end justify-between gap-3">
              <div>
                <div class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-[#E5C985] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <h3 class="font-cormorant text-2xl sm:text-[1.75rem] font-semibold text-[#F5F1E8] leading-none">
                    Havelock Island
                  </h3>
                </div>
                <p class="text-xs sm:text-[13px] text-[#DCD5C7] mt-1 font-light">
                  Pristine Beaches · Sea Hills Havelock Resort
                </p>
                <p class="text-[10.5px] text-[#E5C985] mt-1">
                  Radhanagar (6 km) · Elephant Beach (2.4 km) · Kramuka &amp; Zriya
                </p>
              </div>

              <span
                aria-hidden="true"
                class="w-10 h-10 rounded-full bg-[#091318]/85 group-hover:bg-[#D6B66C] border border-[#E5C985]/80 text-[#F3E7C4] group-hover:text-[#101416] flex items-center justify-center shadow-[0_4px_16px_rgba(0,0,0,0.6)] transition-all duration-300 flex-shrink-0"
              >
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </span>
            </div>
          </a>
        </article>

        <!-- CARD 2 (CENTER ELEVATED · MOST POPULAR): HAVELOCK + PORT BLAIR COMPLETE JOURNEY -->
        <div class="pkg-snake-card pkg-snake-float-2 lg:col-span-4 relative flex flex-col items-center">
          <!-- Top-Right Gold Badge: ☆ Most Popular -->
          <div class="absolute -top-3.5 right-5 z-30 inline-flex items-center gap-1.5 rounded-full bg-gradient-to-r from-[#E2C178] via-[#F3DFA8] to-[#D6B66C] text-[#14100A] px-4 py-1 text-[11px] font-semibold tracking-wide shadow-[0_8px_22px_rgba(214,182,108,0.45)] border border-[#FFF3D6]">
            <svg class="w-3.5 h-3.5 text-[#14100A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
            <span>Most Popular</span>
          </div>

          <article class="w-full group relative rounded-[24px] overflow-hidden border-2 border-[#E8C882] bg-[#0B181F] h-[280px] sm:h-[300px] shadow-[0_28px_70px_rgba(0,0,0,0.85),0_0_38px_rgba(214,182,108,0.28)] transition-colors duration-500">
            <a href="/packages#complete-andaman-island-journey" class="block w-full h-full relative no-underline">
              <img
                src="/frames/Destination/frame_0045.webp"
                alt="Both Islands Andaman Coral Reefs & Luxury Resorts"
                loading="lazy"
                class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#061015]/95 via-[#061015]/30 to-transparent"></div>

              <!-- Top-Left Dual Resort Pill -->
              <div class="absolute top-4 left-4 flex items-center gap-2">
                <span class="rounded-full bg-[#081319]/85 backdrop-blur-md border border-[#E5C985]/60 px-3 py-1 text-[9.5px] uppercase tracking-[0.16em] text-[#F3E7C4] font-semibold">
                  Port Blair + Havelock Combo
                </span>
              </div>

              <!-- Bottom Content + Circular Arrow Button -->
              <div class="absolute inset-x-5 bottom-5 flex items-end justify-between gap-3">
                <div>
                  <div class="flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-[#E5C985] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <h3 class="font-cormorant text-2xl sm:text-[1.9rem] font-semibold text-[#FFF8EB] leading-none">
                      Havelock &amp; Port Blair
                    </h3>
                  </div>
                  <p class="text-xs sm:text-sm text-[#EDE6D6] mt-1 font-light">
                    Island at Its Best · Both Sea Hills Properties
