                  <p class="text-[10.5px] text-[#E5C985] mt-1">
                    Scuba &amp; Reefs · Makruzz/Nautica Ferry · Candlelight Dining
                  </p>
                </div>

                <span
                  aria-hidden="true"
                  class="w-11 h-11 rounded-full bg-[#091318]/90 group-hover:bg-[#E5C985] border border-[#FFF3D6] text-[#FFF3D6] group-hover:text-[#101416] flex items-center justify-center shadow-[0_0_20px_rgba(214,182,108,0.45)] transition-all duration-300 flex-shrink-0"
                >
                  <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </span>
              </div>
            </a>
          </article>

          <!-- Bottom Golden Light Flare & Carousel Dots (Matches Reference Image) -->
          <div class="pointer-events-none w-44 h-1.5 -mt-0.5 rounded-full bg-gradient-to-r from-transparent via-[#F3E7C4] to-transparent blur-[2px]"></div>
          <div class="flex items-center gap-2 mt-2.5" aria-hidden="true">
            <span class="w-2 h-2 rounded-full border border-[#D6B66C]/70 bg-transparent"></span>
            <span class="w-2.5 h-2.5 rounded-full border border-[#FFF3D6] bg-[#E5C985] shadow-[0_0_8px_#D6B66C]"></span>
            <span class="w-2 h-2 rounded-full border border-[#D6B66C]/70 bg-transparent"></span>
          </div>
        </div>

        <!-- CARD 3 (RIGHT): PORT BLAIR · THE GATEWAY -->
        <article class="pkg-snake-card pkg-snake-float-3 lg:col-span-4 group relative rounded-[22px] overflow-hidden border border-[#D6B66C]/60 hover:border-[#FFF3D6] bg-[#0B181F] h-[250px] sm:h-[265px] shadow-[0_22px_55px_rgba(0,0,0,0.75)] transition-colors duration-500">
          <a href="/packages#port-blair-gateway-escape" class="block w-full h-full relative no-underline">
            <img
              src="/frames/Destination/frame_0001.webp"
              alt="Sea Hills Hotel Port Blair The Gateway"
              loading="lazy"
              class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#061015]/95 via-[#061015]/35 to-transparent"></div>

            <!-- Top-Left Authentic PDF Quick Pills -->
            <div class="absolute top-3.5 left-3.5 right-3.5 flex flex-wrap items-center justify-between gap-1.5">
              <span class="rounded-full bg-[#081319]/80 backdrop-blur-md border border-[#D6B66C]/50 px-3 py-1 text-[9.5px] uppercase tracking-[0.16em] text-[#F3E7C4] font-semibold">
                5 Room Categories · 269–452 Sq Ft
              </span>
              <span class="rounded-full bg-[#081319]/80 backdrop-blur-md border border-white/15 px-2.5 py-1 text-[9.5px] text-[#E5DFD2]">
                Airport 3.9 Km · Jetty 3.2 Km
              </span>
            </div>

            <!-- Bottom Content + Circular Arrow Button -->
            <div class="absolute inset-x-4 sm:inset-x-5 bottom-4 sm:bottom-5 flex items-end justify-between gap-3">
              <div>
                <div class="flex items-center gap-1.5">
                  <svg class="w-4 h-4 text-[#E5C985] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <h3 class="font-cormorant text-2xl sm:text-[1.75rem] font-semibold text-[#F5F1E8] leading-none">
                    Port Blair
                  </h3>
                </div>
                <p class="text-xs sm:text-[13px] text-[#DCD5C7] mt-1 font-light">
                  The Gateway · Sea Hills Port Blair Hotel
                </p>
                <p class="text-[10.5px] text-[#E5C985] mt-1">
                  Cleopatra Dining · Anubis Rooftop Bar · Cellular Jail (2.7 km)
                </p>
              </div>

              <span
                aria-hidden="true"
                class="w-10 h-10 rounded-full bg-[#091318]/85 group-hover:bg-[#D6B66C] border border-[#E5C985]/80 text-[#F3E7C4] group-hover:text-[#101416] flex items-center justify-center shadow-[0_4px_16px_rgba(0,0,0,0.6)] transition-all duration-300 flex-shrink-0"
              >
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </span>
            </div>
          </a>
        </article>
      </div>

      <!-- =====================================================================
           FIVE-PILLAR TRUST BAR (Matches Bottom Pill Bar in Reference Image)
           Luxury Resorts | Premium Experiences | Island Activities | Safe & Trusted | 24/7 Support
           ===================================================================== -->
      <div class="mt-7 sm:mt-8 max-w-5xl mx-auto rounded-full bg-[#071319]/90 backdrop-blur-xl border border-[#D6B66C]/45 px-4 sm:px-8 py-3.5 sm:py-4 shadow-[0_18px_48px_rgba(0,0,0,0.8)]">
        <div class="grid grid-cols-2 sm:grid-cols-5 gap-y-4 sm:gap-y-0 items-center divide-y sm:divide-y-0 sm:divide-x divide-[#D6B66C]/25">
          <!-- 1. Luxury Resorts -->
          <div class="pkg-snake-pillar flex flex-col items-center justify-center text-center px-2">
            <svg class="w-5 h-5 text-[#E5C985] mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 3h12l4 6-10 12L2 9l4-6z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M2 9h20M12 21L8 9l4-6 4 6-4 12z" />
            </svg>
            <span class="text-[11px] sm:text-xs font-medium text-[#F5F1E8] tracking-wide">Luxury Resorts</span>
          </div>

          <!-- 2. Premium Experiences -->
          <div class="pkg-snake-pillar flex flex-col items-center justify-center text-center px-2 pt-3 sm:pt-0">
            <svg class="w-5 h-5 text-[#E5C985] mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21V11m0 0c-2.5-4-7-4.5-8-2 2.5 0 5.5 1 8 2zm0 0c2.5-4 7-4.5 8-2-2.5 0-5.5 1-8 2zm0 0c-1.5-4.5-5-7-7-6 2 1.5 4.5 3.5 7 6zm0 0c1.5-4.5 5-7 7-6-2 1.5-4.5 3.5-7 6z" />
            </svg>
            <span class="text-[11px] sm:text-xs font-medium text-[#F5F1E8] tracking-wide">Premium Experiences</span>
          </div>

          <!-- 3. Island Activities -->
          <div class="pkg-snake-pillar flex flex-col items-center justify-center text-center px-2 pt-3 sm:pt-0">
            <svg class="w-5 h-5 text-[#E5C985] mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 15c2.5 0 3.5-2 6-2s3.5 2 6 2 3.5-2 6-2M3 19c2.5 0 3.5-2 6-2s3.5 2 6 2 3.5-2 6-2M14 7a3 3 0 116 0" />
            </svg>
            <span class="text-[11px] sm:text-xs font-medium text-[#F5F1E8] tracking-wide">Island Activities</span>
          </div>

          <!-- 4. Safe & Trusted -->
          <div class="pkg-snake-pillar flex flex-col items-center justify-center text-center px-2 pt-3 sm:pt-0">
            <svg class="w-5 h-5 text-[#E5C985] mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7 4v5c0 5-3.5 8.5-7 9-3.5-.5-7-4-7-9V7l7-4z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" />
            </svg>
            <span class="text-[11px] sm:text-xs font-medium text-[#F5F1E8] tracking-wide">Safe &amp; Trusted</span>
          </div>

          <!-- 5. 24/7 Support -->
          <div class="pkg-snake-pillar col-span-2 sm:col-span-1 flex flex-col items-center justify-center text-center px-2 pt-3 sm:pt-0">
            <svg class="w-5 h-5 text-[#E5C985] mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 13v-1a8 8 0 0116 0v1m-2 0a2 2 0 012 2v2a2 2 0 01-2 2h-1v-6h1zm-12 0a2 2 0 00-2 2v2a2 2 0 002 2h1v-6H6zm10 6a3 3 0 01-3 3h-2" />
            </svg>
            <span class="text-[11px] sm:text-xs font-medium text-[#F5F1E8] tracking-wide">24/7 Support</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({ ignoreMobileResize: true });

  function initPackagesSnakeScroll() {
    const section = document.getElementById('packages');
    if (!section || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const cards = Array.from(section.querySelectorAll('.pkg-snake-card')) as HTMLElement[];
    const pillars = Array.from(section.querySelectorAll('.pkg-snake-pillar')) as HTMLElement[];
    const headingEls = section.querySelectorAll('h2, #view-all-packages-btn');

    if (headingEls.length) {
      gsap.fromTo(
        headingEls,
        { opacity: 0, y: 26 },
        {
          opacity: 1,
          y: 0,
          duration: 0.7,
          stagger: 0.12,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: section,
            start: 'top 82%',
            toggleActions: 'play none none reverse',
          },
        }
      );
    }

    // Snake Wave One-by-One Entrance for the 3 Destination Package Image Cards
    if (cards.length) {
      const snakeOffsets = [
        { x: -95, y: 70, rotation: -5, scale: 0.9 },
        { x: 0, y: -80, rotation: 4, scale: 0.9 },
        { x: 95, y: 70, rotation: -4, scale: 0.9 },
      ];

      cards.forEach((card, idx) => {
        const from = snakeOffsets[idx % snakeOffsets.length];
        gsap.fromTo(
          card,
          {
            opacity: 0,
            x: from.x,
            y: from.y,
            rotation: from.rotation,
            scale: from.scale,
          },
          {
            opacity: 1,
            x: 0,
            y: 0,
            rotation: 0,
            scale: 1,
            duration: 0.85,
            delay: idx * 0.28,
            ease: 'back.out(1.35)',
            clearProps: 'transform',
            scrollTrigger: {
              trigger: section,
              start: 'top 72%',
              toggleActions: 'play none none reverse',
            },
          }
        );
      });
    }

    // Snake Wave One-by-One Ripple for the 5 Bottom Trust Pillars
    if (pillars.length) {
      pillars.forEach((pillar, idx) => {
        const dir = idx % 2 === 0 ? 28 : -28;
        gsap.fromTo(
          pillar,
          { opacity: 0, y: dir, scale: 0.92 },
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.6,
            delay: 0.45 + idx * 0.14,
            ease: 'power3.out',
            clearProps: 'transform',
            scrollTrigger: {
              trigger: section,
              start: 'top 68%',
              toggleActions: 'play none none reverse',
            },
          }
        );
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPackagesSnakeScroll);
  } else {
    initPackagesSnakeScroll();
  }
</script>
