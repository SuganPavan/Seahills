        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#101416]/85 backdrop-blur-md border border-[#D6B66C]/75 group-hover/pin-hl:border-[#FFF3D6] shadow-[0_8px_24px_rgba(0,0,0,0.7),0_0_16px_rgba(214,182,108,0.28)] transition-all duration-300 group-hover/pin-hl:-translate-y-0.5">
          <span class="relative flex items-center justify-center">
            <span class="absolute -inset-1 rounded-full bg-[#D6B66C]/45 animate-ping"></span>
            <svg class="relative w-3.5 h-3.5 text-[#D6B66C]" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742zM12 13.5a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
            </svg>
