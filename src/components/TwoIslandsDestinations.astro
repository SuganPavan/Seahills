            class="flex-shrink-0 inline-flex items-center gap-1.5 bg-gradient-to-r from-[#D6B66C] to-[#E5C985] hover:from-[#e6c880] hover:to-[#f6dea4] text-[#101416] font-sans font-semibold text-[10px] sm:text-[10.5px] tracking-[0.14em] uppercase px-4 py-2 rounded-full transition-all duration-300 shadow-[0_4px_16px_rgba(214,182,108,0.32)] whitespace-nowrap"
