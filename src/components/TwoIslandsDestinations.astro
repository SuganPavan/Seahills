      </a>

      <!-- RIGHT ISLAND LOCATION PIN: HAVELOCK -->
      <a
        href="#destination-havelock"
        id="pin-havelock"
        class="absolute top-[16%] sm:top-[20%] right-[8%] sm:right-[13%] z-20 flex flex-col items-center group/pin-hl select-none"
