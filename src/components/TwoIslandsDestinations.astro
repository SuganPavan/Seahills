---
// TwoIslandsDestinations.astro - SECTION 2: TWO ISLANDS. TWO DISTINCT EXPERIENCES.
// Crystal-clear unobstructed 16:9 Golden-Framed Panoramic Stage (public/frames/Destination)
// Paired with two sleek symmetrical luxury destination cards cleanly positioned below the panorama
// Palette: Champagne Gold (#D6B66C), Luminous Gold (#F3E7C4), Midnight Black (#101416), Soft Ivory (#F5F1E8)
import fs from 'node:fs';
import path from 'node:path';

const destFramesDir = path.join(process.cwd(), 'public', 'frames', 'Destination');
let destFrameUrls: string[] = [];
if (fs.existsSync(destFramesDir)) {
  destFrameUrls = fs
    .readdirSync(destFramesDir)
    .filter((f) => /^frame_\d+\.webp$/i.test(f))
    .sort()
    .map((f) => `/frames/Destination/${f}`);
}
---

<section id="destinations-section" class="relative w-full bg-[#101416]" style="height: 220vh;" data-frames={JSON.stringify(destFrameUrls)}>

  <!-- Sticky Viewport Stage (svh prevents mobile URL-bar jitter) -->
  <div class="sticky top-0 h-[100svh] w-full overflow-hidden flex flex-col justify-center items-center py-4 sm:py-6 px-4 sm:px-6 lg:px-8">

    <!-- Subtle Champagne Radial Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[860px] h-[520px] bg-gradient-radial from-[#D6B66C]/10 via-[#D6B66C]/3 to-transparent rounded-full blur-3xl pointer-events-none"></div>

    <!-- SECTION HEADER -->
    <header class="relative z-30 w-full max-w-[1280px] text-center mb-3 select-none">
      <div class="flex items-center justify-center gap-3 sm:gap-5">
        <span class="w-10 sm:w-20 lg:w-28 h-[1px] bg-gradient-to-r from-transparent via-[#D6B66C]/60 to-[#D6B66C]"></span>
        <h2 class="text-[11px] sm:text-xs md:text-[13px] tracking-[0.28em] uppercase font-sans font-semibold text-transparent bg-clip-text bg-gradient-to-r from-[#D6B66C] via-[#FFF3D6] to-[#D6B66C]">
          TWO ISLANDS. TWO DISTINCT EXPERIENCES.
        </h2>
        <span class="w-10 sm:w-20 lg:w-28 h-[1px] bg-gradient-to-l from-transparent via-[#D6B66C]/60 to-[#D6B66C]"></span>
      </div>

      <!-- Center Ferry Cruise Status Badge -->
      <div class="mt-2 inline-flex items-center gap-2 px-4 py-1 rounded-full bg-[#101416]/90 border border-[#D6B66C]/50 shadow-[0_0_20px_rgba(214,182,108,0.18)]">
        <span class="w-2 h-2 rounded-full bg-[#D6B66C] animate-pulse shadow-[0_0_8px_#D6B66C]"></span>
        <span id="ferry-status-text" class="text-[9.5px] sm:text-[10.5px] tracking-[0.2em] uppercase font-sans font-medium text-[#F3E7C4]">
          Departing Port Blair Harbor · Boarding Sea Hills Ferry
        </span>
      </div>
    </header>

    <!-- UNOBSTRUCTED CRYSTAL-CLEAR 16:9 PANORAMIC STAGE (ZERO BLUR / ZERO OVERLAY CLUTTER) -->
    <div
      id="dest-stage-frame"
      class="relative z-20 w-full max-w-[1160px] aspect-[16/9] max-h-[48vh] rounded-2xl sm:rounded-3xl overflow-hidden border border-[#D6B66C]/55 shadow-[0_24px_65px_rgba(0,0,0,0.85),0_0_36px_rgba(214,182,108,0.16)] bg-[#101416]"
    >
      <!-- High-DPI Canvas for Crisp 60fps Frame Scrubbing -->
      <canvas
        id="dest-canvas"
        class="absolute inset-0 w-full h-full z-0 block"
        aria-hidden="true"
      ></canvas>

      <!-- First-Frame Immediate Fallback -->
      <img
        id="dest-fallback"
        src={destFrameUrls[0] || '/frames/Destination/frame_0001.webp'}
        alt="Aerial view of Andaman Islands connecting Port Blair and Havelock Island"
        class="absolute inset-0 w-full h-full object-cover object-center z-0 pointer-events-none transition-opacity duration-300"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />

      <!-- Minimal Bottom Vignette for Progress Track Legibility Only -->
      <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-[#101416]/80 to-transparent pointer-events-none z-10"></div>

      <!-- LEFT ISLAND LOCATION PIN: PORT BLAIR -->
      <a
        href="#destination-port-blair"
        id="pin-port-blair"
        class="absolute top-[18%] sm:top-[22%] left-[8%] sm:left-[13%] z-20 flex flex-col items-center group/pin-pb select-none"
      >
        <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-[#101416]/85 backdrop-blur-md border border-[#D6B66C]/75 group-hover/pin-pb:border-[#FFF3D6] shadow-[0_8px_24px_rgba(0,0,0,0.7),0_0_16px_rgba(214,182,108,0.28)] transition-all duration-300 group-hover/pin-pb:-translate-y-0.5">
          <span class="relative flex items-center justify-center">
            <span class="absolute -inset-1 rounded-full bg-[#D6B66C]/45 animate-ping"></span>
            <svg class="relative w-3.5 h-3.5 text-[#D6B66C]" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-1.99 3.963-4.98 3.963-8.827a8.25 8.25 0 00-16.5 0c0 3.846 2.02 6.837 3.963 8.827a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.145.742zM12 13.5a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
            </svg>
          </span>
