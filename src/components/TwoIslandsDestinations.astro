    </div>

    <!-- TWO PROMINENTLY HIGHLIGHTED LUXURY DESTINATION CARDS BELOW THE PANORAMA -->
    <div class="relative z-30 w-full max-w-[1160px] grid grid-cols-1 sm:grid-cols-2 gap-3.5 sm:gap-5 mt-3.5 sm:mt-4">

      <!-- CARD 1: PORT BLAIR -->
      <article
        id="card-port-blair"
        class="group/port relative overflow-hidden rounded-2xl bg-gradient-to-br from-[#1A2025] via-[#14191D] to-[#101417] border border-[#D6B66C]/65 hover:border-[#FFF3D6] px-5 py-4 sm:px-6 sm:py-5 shadow-[0_16px_42px_rgba(0,0,0,0.7),0_0_24px_rgba(214,182,108,0.16)] hover:shadow-[0_20px_48px_rgba(214,182,108,0.28)] transition-all duration-300 flex flex-col justify-between gap-3"
