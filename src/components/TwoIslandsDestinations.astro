</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  function initDestinationScrolly() {
    gsap.registerPlugin(ScrollTrigger);

    const section = document.getElementById('destinations-section');
    const canvas = document.getElementById('dest-canvas') as HTMLCanvasElement | null;
    const fallbackImg = document.getElementById('dest-fallback') as HTMLImageElement | null;
    const progressBar = document.getElementById('dest-progress-bar');
    const statusText = document.getElementById('ferry-status-text');
    const portCard = document.getElementById('card-port-blair');
    const havelockCard = document.getElementById('card-havelock');

    if (!section || !canvas) return;

    const ctx = canvas.getContext('2d', { alpha: false });
    if (!ctx) return;

    let FRAME_URLS: string[] = [];
    try {
      FRAME_URLS = JSON.parse(section.dataset.frames || '[]');
    } catch {
      FRAME_URLS = [];
    }
    const TOTAL_FRAMES = FRAME_URLS.length || 61;
    const frameUrl = (i: number) =>
      FRAME_URLS[i] || `/frames/Destination/frame_${String(i + 1).padStart(4, '0')}.webp`;

    const frames: (HTMLImageElement | null)[] = new Array(TOTAL_FRAMES).fill(null);
    let lastDrawn = -1;
    let initialDrawComplete = false;

    function resizeCanvas() {
      if (!canvas) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = canvas.clientWidth || 1160;
      const h = canvas.clientHeight || 652;
      const targetW = Math.round(w * dpr);
      const targetH = Math.round(h * dpr);

      if (canvas.width !== targetW || canvas.height !== targetH) {
        canvas.width = targetW;
        canvas.height = targetH;
      }
      if (lastDrawn >= 0) draw(lastDrawn);
    }

    function draw(idx: number) {
      if (!ctx || !canvas) return;
      let img = frames[idx];
      if (!img || !img.complete || img.naturalWidth === 0) {
        for (let offset = 1; offset < TOTAL_FRAMES; offset++) {
          if (idx - offset >= 0 && frames[idx - offset]?.complete) {
            img = frames[idx - offset];
            break;
          }
          if (idx + offset < TOTAL_FRAMES && frames[idx + offset]?.complete) {
            img = frames[idx + offset];
            break;
          }
        }
      }
      if (!img || !img.complete || img.naturalWidth === 0) return;

      const cw = canvas.width;
      const ch = canvas.height;
      const iw = img.naturalWidth;
      const ih = img.naturalHeight;

      const scale = Math.max(cw / iw, ch / ih);
      const nw = iw * scale;
      const nh = ih * scale;
      const x = (cw - nw) / 2;
      const y = (ch - nh) / 2;

      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      ctx.drawImage(img, x, y, nw, nh);
      lastDrawn = idx;

      if (!initialDrawComplete) {
        initialDrawComplete = true;
        if (fallbackImg) fallbackImg.style.opacity = '0';
      }
    }

    function loadFrame(i: number): Promise<void> {
      return new Promise((resolve) => {
        if (frames[i]) return resolve();
        const img = new Image();
        img.decoding = 'async';
        img.src = frameUrl(i);
        img.onload = () => {
          frames[i] = img;
          const current = Math.round(frameTracker.frame);
          if (Math.abs(i - current) <= 1) {
            draw(current);
          }
          resolve();
        };
        img.onerror = () => resolve();
      });
    }

    async function preloadFrames() {
      await loadFrame(0);
      draw(0);

      const milestones = [
        0,
        Math.round((TOTAL_FRAMES - 1) * 0.25),
        Math.round((TOTAL_FRAMES - 1) * 0.5),
        Math.round((TOTAL_FRAMES - 1) * 0.75),
        TOTAL_FRAMES - 1
      ];
      milestones.forEach((idx) => loadFrame(idx));

      for (let i = 1; i <= Math.min(12, TOTAL_FRAMES - 1); i++) {
        loadFrame(i);
      }

      const remaining: number[] = [];
      for (let i = 13; i < TOTAL_FRAMES; i++) {
        if (!frames[i] && !milestones.includes(i)) remaining.push(i);
      }
      for (let i = 0; i < remaining.length; i += 8) {
        const batch = remaining.slice(i, i + 8);
        await Promise.all(batch.map((idx) => loadFrame(idx)));
      }
      ScrollTrigger.refresh();
    }

    const frameTracker = { frame: 0 };

    // Butter-smooth 1:1 scrub (eliminates double-smoothing sticking with Lenis)
    gsap.to(frameTracker, {
      frame: TOTAL_FRAMES - 1,
      ease: 'none',
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: 'bottom bottom',
        scrub: true,
        onUpdate: (self) => {
          const current = Math.min(TOTAL_FRAMES - 1, Math.max(0, Math.round(frameTracker.frame)));
          if (current !== lastDrawn) {
            draw(current);
          }

          const progress = self.progress;

          if (progressBar) {
            progressBar.style.width = `${Math.max(5, progress * 100)}%`;
          }

          if (statusText) {
            if (progress < 0.35) {
              statusText.textContent = 'Departing Port Blair Harbor · Boarding Sea Hills Ferry';
              portCard?.classList.add('border-[#FFF3D6]', 'ring-2', 'ring-[#D6B66C]/70', 'shadow-[0_0_32px_rgba(214,182,108,0.35)]');
              havelockCard?.classList.remove('border-[#FFF3D6]', 'ring-2', 'ring-[#D6B66C]/70', 'shadow-[0_0_32px_rgba(214,182,108,0.35)]');
            } else if (progress < 0.7) {
              statusText.textContent = 'Cruising Across Emerald Andaman Waters · 90 Min Scenic Voyage';
              portCard?.classList.remove('border-[#FFF3D6]', 'ring-2', 'ring-[#D6B66C]/70', 'shadow-[0_0_32px_rgba(214,182,108,0.35)]');
              havelockCard?.classList.remove('border-[#FFF3D6]', 'ring-2', 'ring-[#D6B66C]/70', 'shadow-[0_0_32px_rgba(214,182,108,0.35)]');
            } else {
              statusText.textContent = 'Arriving at Havelock Island · Pristine Beachside Cove';
              portCard?.classList.remove('border-[#FFF3D6]', 'ring-2', 'ring-[#D6B66C]/70', 'shadow-[0_0_32px_rgba(214,182,108,0.35)]');
              havelockCard?.classList.add('border-[#FFF3D6]', 'ring-2', 'ring-[#D6B66C]/70', 'shadow-[0_0_32px_rgba(214,182,108,0.35)]');
            }
          }
        }
      }
    });

    window.addEventListener('resize', resizeCanvas, { passive: true });
    resizeCanvas();

    // Load frame 0 immediately; defer remaining frames until approaching Section 2 so Hero stays 60fps
    loadFrame(0).then(() => draw(0));
    let preloaded = false;
    const startPreload = () => {
      if (preloaded) return;
      preloaded = true;
      preloadFrames();
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            startPreload();
            io.disconnect();
          }
        },
        { rootMargin: '1200px 0px' }
      );
      io.observe(section);
    } else {
      startPreload();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDestinationScrolly);
  } else {
    initDestinationScrolly();
  }
</script>
