        <div class="w-[1.5px] h-4 sm:h-5 bg-gradient-to-b from-[#D6B66C] to-transparent"></div>
        <span class="w-2 h-2 rounded-full bg-[#D6B66C] ring-4 ring-[#D6B66C]/30 shadow-[0_0_10px_#D6B66C]"></span>
      </a>

      <!-- Subtle Golden Progress Track Inside Bottom Edge -->
      <div class="absolute inset-x-4 sm:inset-x-7 bottom-3 sm:bottom-4 z-20 flex items-center justify-between gap-4 text-[#F3E7C4] text-[9.5px] sm:text-[10px] tracking-[0.2em] uppercase select-none">
        <span class="flex items-center gap-1.5 font-medium text-[#D6B66C] whitespace-nowrap">
