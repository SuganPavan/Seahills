        class="group/havelock relative overflow-hidden rounded-2xl bg-gradient-to-br from-[#1A2025] via-[#14191D] to-[#101417] border border-[#D6B66C]/65 hover:border-[#FFF3D6] px-5 py-4 sm:px-6 sm:py-5 shadow-[0_16px_42px_rgba(0,0,0,0.7),0_0_24px_rgba(214,182,108,0.16)] hover:shadow-[0_20px_48px_rgba(214,182,108,0.28)] transition-all duration-300 flex flex-col justify-between gap-3"
      >
        <div class="absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-[#D6B66C]/20 via-[#FFF3D6] to-[#D6B66C]/20"></div>

        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2 mb-1.5">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#D6B66C]/15 border border-[#D6B66C]/50 text-[9.5px] font-sans font-semibold tracking-[0.18em] uppercase text-[#F3E7C4]">
                <span class="w-1.5 h-1.5 rounded-full bg-[#D6B66C]"></span>
