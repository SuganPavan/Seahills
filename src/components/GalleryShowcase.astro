---
const visualMoments = [
  {
    title: 'Sea Hills Andaman ♡',
    category: 'Resorts & Stays',
    image: '/frames/Home_Section/frame_0025.webp',
  },
  {
    title: 'Two Islands Horizon',
    category: 'Island Escapes',
    image: '/frames/Destination/frame_0001.webp',
  },
  {
    title: 'Emerald Bay & Reefs',
    category: 'Underwater World',
    image: '/frames/Destination/frame_0045.webp',
  },
  {
    title: 'Anubis Bar & Lounge',
    category: 'Dining & Lifestyle',
    image: '/images/facilities/bar.jpg',
  },
  {
    title: 'Luxury Island Suites',
    category: 'Resorts & Stays',
    image: '/frames/rooms/frame_0060.webp',
  },
  {
    title: 'Tropical Pool Oasis',
    category: 'Experiences',
    image: '/images/facilities/pool-bright.jpg',
  },
];

const filters = [
  'All Moments',
  'Resorts & Stays',
  'Island Escapes',
  'Dining & Lifestyle',
  'Underwater World',
  'Experiences',
];
---

<section
  id="gallery"
  class="relative bg-gradient-to-b from-[#071115] via-[#0B171D] to-[#081014] text-[#F5F1E8] pt-14 pb-20 px-4 sm:px-8 lg:px-12 overflow-hidden"
>
  <!-- Top Champagne Gold Wave Divider -->
  <div class="pointer-events-none absolute top-0 inset-x-0 w-full overflow-hidden leading-none">
    <svg viewBox="0 0 1440 42" fill="none" class="w-full h-9 sm:h-10" preserveAspectRatio="none">
      <path
        d="M0 20 Q 360 42 720 18 T 1440 20"
        stroke="url(#gallery-wave-top)"
        stroke-width="1.5"
        fill="none"
      />
      <defs>
        <linearGradient id="gallery-wave-top" x1="0" y1="0" x2="1440" y2="0" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#D6B66C" stop-opacity="0.1" />
          <stop offset="50%" stop-color="#F3E7C4" stop-opacity="0.8" />
          <stop offset="100%" stop-color="#D6B66C" stop-opacity="0.1" />
        </linearGradient>
      </defs>
    </svg>
  </div>

  <div class="relative z-10 max-w-[1320px] mx-auto pt-6">
    <!-- Top Header + 2x3 Filter Pills -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-7 mb-10 sm:mb-12">
      <div>
        <div class="flex items-center gap-3 mb-2.5">
          <span class="inline-block w-7 h-[1px] bg-[#D6B66C]"></span>
          <span class="text-[10px] uppercase tracking-[0.28em] text-[#D6B66C] font-semibold">
            The Sea Hills Visual Journal
          </span>
        </div>

        <h2 class="font-cormorant text-4xl sm:text-5xl lg:text-[3.2rem] leading-[1.06] text-[#F5F1E8] font-normal">
          The Art of <span class="text-[#F3E7C4] italic">Island Living</span>
        </h2>
        <p class="font-cormorant italic text-lg text-[#C8BFAE] mt-1">
          Every Frame Tells an Island Story.
        </p>
      </div>

      <!-- 2-Row x 3-Column Filter Pills -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 max-w-xl">
        {filters.map((cat, idx) => (
          <button
            type="button"
            data-journal-filter={cat}
            class={`journal-filter-btn rounded-full px-3.5 py-2 text-[11px] font-medium tracking-wide border transition-all duration-300 text-center whitespace-nowrap ${
              idx === 0
                ? 'bg-gradient-to-r from-[#D6B66C] to-[#E6C987] text-[#101416] border-[#D6B66C] font-semibold shadow-[0_6px_18px_rgba(214,182,108,0.3)]'
                : 'bg-[#101A1F]/75 text-[#E5DFD2] border-[#D6B66C]/30 hover:border-[#D6B66C]'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Fanned & Overlapping Tilted Polaroid Collage with Edge Arrows -->
    <div class="relative px-2 sm:px-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-4 lg:gap-0 items-center">
        <!-- Left Card (-4deg) -->
        <a
          href="/gallery"
          data-journal-card
          data-journal-category={visualMoments[0].category}
          class="journal-photo-card lg:col-span-3 relative z-10 rounded-2xl overflow-hidden border-[3px] border-[#F5F1E8]/90 bg-[#14191C] h-[270px] sm:h-[290px] shadow-[0_24px_55px_rgba(0,0,0,0.8)] lg:-rotate-[4deg] hover:rotate-0 hover:z-30 transition-all duration-500 lg:-mr-3"
        >
          <img src={visualMoments[0].image} alt={visualMoments[0].title} loading="lazy" class="w-full h-full object-cover" />
          <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[#091014]/90 to-transparent"></div>
          <p class="absolute bottom-3.5 left-4 font-cormorant italic text-2xl text-[#F5F1E8]">
            {visualMoments[0].title}
          </p>
        </a>

        <!-- Center-Left Stack (+2deg & -1.5deg) -->
        <div class="lg:col-span-3 flex flex-col gap-3 relative z-10 lg:-mr-3">
          <a
            href="/gallery"
            data-journal-card
            data-journal-category={visualMoments[1].category}
            class="journal-photo-card relative rounded-2xl overflow-hidden border-[3px] border-[#F5F1E8]/85 bg-[#14191C] h-[175px] shadow-[0_20px_45px_rgba(0,0,0,0.75)] lg:rotate-[2deg] hover:rotate-0 hover:z-30 transition-all duration-500"
          >
            <img src={visualMoments[1].image} alt={visualMoments[1].title} loading="lazy" class="w-full h-full object-cover" />
          </a>

          <a
            href="/gallery"
            data-journal-card
            data-journal-category={visualMoments[5].category}
            class="journal-photo-card relative rounded-2xl overflow-hidden border-[3px] border-[#F5F1E8]/85 bg-[#14191C] h-[130px] shadow-[0_18px_40px_rgba(0,0,0,0.75)] lg:-rotate-[1.5deg] hover:rotate-0 hover:z-30 transition-all duration-500"
          >
            <img src={visualMoments[5].image} alt={visualMoments[5].title} loading="lazy" class="w-full h-full object-cover" />
          </a>
        </div>

        <!-- Center Hero Spotlight Card (Largest, z-20) -->
        <a
          href="/gallery"
          data-journal-card
          data-journal-category={visualMoments[2].category}
          class="journal-photo-card lg:col-span-3 relative z-20 rounded-2xl overflow-hidden border-[3px] border-[#F3E7C4] bg-[#14191C] h-[310px] sm:h-[330px] shadow-[0_28px_70px_rgba(0,0,0,0.85),0_0_32px_rgba(214,182,108,0.22)] lg:-rotate-[1.2deg] hover:rotate-0 hover:z-30 transition-all duration-500"
        >
          <img src={visualMoments[2].image} alt={visualMoments[2].title} loading="lazy" class="w-full h-full object-cover" />
          <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-[#091014]/85 to-transparent"></div>
          <p class="absolute bottom-3.5 left-4 font-cormorant text-xl text-[#F3E7C4]">
            {visualMoments[2].title}
          </p>
        </a>

        <!-- Right Stack (+2.5deg & -2deg) -->
        <div class="lg:col-span-3 flex flex-col gap-3 relative z-10 lg:-ml-3">
          <a
            href="/gallery"
            data-journal-card
            data-journal-category={visualMoments[3].category}
            class="journal-photo-card relative rounded-2xl overflow-hidden border-[3px] border-[#F5F1E8]/85 bg-[#14191C] h-[145px] shadow-[0_20px_45px_rgba(0,0,0,0.75)] lg:rotate-[2.5deg] hover:rotate-0 hover:z-30 transition-all duration-500"
          >
            <img src={visualMoments[3].image} alt={visualMoments[3].title} loading="lazy" class="w-full h-full object-cover" />
          </a>

          <a
            href="/gallery"
            data-journal-card
            data-journal-category={visualMoments[4].category}
            class="journal-photo-card relative rounded-2xl overflow-hidden border-[3px] border-[#F5F1E8]/85 bg-[#14191C] h-[165px] shadow-[0_20px_45px_rgba(0,0,0,0.75)] lg:-rotate-[2deg] hover:rotate-0 hover:z-30 transition-all duration-500"
          >
            <img src={visualMoments[4].image} alt={visualMoments[4].title} loading="lazy" class="w-full h-full object-cover" />
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Centered Explore Gallery CTA + Golden Wave Shell Emblem -->
    <div class="mt-10 flex flex-col items-center gap-4">
      <div class="flex items-center justify-center gap-4 w-full max-w-lg">
        <span class="h-[1px] flex-1 bg-gradient-to-r from-transparent to-[#D6B66C]/60"></span>
        <a
          id="view-full-gallery-btn"
          href="/gallery"
          class="inline-flex items-center gap-2.5 rounded-full border border-[#D6B66C] bg-[#0B171D]/85 hover:bg-[#D6B66C] text-[#F3E7C4] hover:text-[#101416] px-7 py-2.5 text-xs uppercase tracking-[0.18em] font-semibold shadow-[0_10px_28px_rgba(0,0,0,0.45)] transition-all duration-300"
        >
          <span>Explore Gallery</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <span class="h-[1px] flex-1 bg-gradient-to-l from-transparent to-[#D6B66C]/60"></span>
      </div>

      <!-- Golden Scallop Shell Emblem -->
      <svg class="w-6 h-6 text-[#D6B66C]/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M12 20c4.5 0 8-3.2 8-7.5C20 8.5 16.5 5 12 5S4 8.5 4 12.5C4 16.8 7.5 20 12 20z" />
        <path d="M12 5v15M8 7l4 13M16 7l-4 13" stroke-linecap="round" />
      </svg>
    </div>
  </div>
</section>

<script>
  const filterBtns = Array.from(document.querySelectorAll('.journal-filter-btn')) as HTMLElement[];
  const photoCards = Array.from(document.querySelectorAll('.journal-photo-card')) as HTMLElement[];

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.journalFilter || 'All Moments';

      filterBtns.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('bg-gradient-to-r', active);
        b.classList.toggle('from-[#D6B66C]', active);
        b.classList.toggle('to-[#E6C987]', active);
        b.classList.toggle('text-[#101416]', active);
        b.classList.toggle('border-[#D6B66C]', active);
        b.classList.toggle('font-semibold', active);
        b.classList.toggle('bg-[#101A1F]/75', !active);
        b.classList.toggle('text-[#E5DFD2]', !active);
      });

      photoCards.forEach((card) => {
        const cat = card.dataset.journalCategory;
        const match = target === 'All Moments' || cat === target;
        card.style.opacity = match ? '1' : '0.28';
        card.style.filter = match ? 'none' : 'grayscale(65%)';
      });
    });
  });
</script>
