---
import fs from 'node:fs';
import path from 'node:path';

const publicDir = path.join(process.cwd(), 'public');
const roomsColDir = path.join(publicDir, 'images', 'rooms-collection');
const diningScrollDir = path.join(publicDir, 'images', 'dining-scroll');
const gallerySyncDir = path.join(publicDir, 'images', 'hotel-gallery');
const uploadedDir =
  'C:\\Users\\sugan\\.gemini\\antigravity\\brain\\93857b95-74ba-4984-b01e-a2ff534fa52e\\.user_uploaded';
const imageExtRe = /\.(webp|jpe?g|png|avif)$/i;

function resolveOriginalHotelPhoto(
  key: string,
  uploadedFile: string | null,
  localFolder: string | null,
  syncedDir: string,
  syncedPrefix: string,
  fallbackUrl: string
): string {
  // 1. Check already-synced rooms-collection or dining-scroll in public/
  if (fs.existsSync(syncedDir)) {
    const match = fs
      .readdirSync(syncedDir)
      .find((f) => f.startsWith(syncedPrefix) && imageExtRe.test(f));
    if (match) {
      const rel = path.relative(publicDir, path.join(syncedDir, match)).replace(/\\/g, '/');
      return `/${rel}`;
    }
  }

  // 2. Check uploaded original hotel photo
  if (uploadedFile) {
    const upPath = path.join(uploadedDir, uploadedFile);
    if (fs.existsSync(upPath)) {
      fs.mkdirSync(gallerySyncDir, { recursive: true });
      const ext = path.extname(upPath).toLowerCase() || '.jpg';
      const outName = `${key}${ext}`;
      fs.writeFileSync(path.join(gallerySyncDir, outName), fs.readFileSync(upPath));
      return `/images/hotel-gallery/${outName}`;
    }
  }

  // 3. Check D:\Sea_shell original hotel folder
  if (localFolder && fs.existsSync(localFolder)) {
    const files = fs
      .readdirSync(localFolder)
      .filter((f) => imageExtRe.test(f))
      .sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }));
    if (files.length > 0) {
      fs.mkdirSync(gallerySyncDir, { recursive: true });
      const ext = path.extname(files[0]).toLowerCase() || '.jpg';
      const outName = `${key}${ext}`;
      fs.writeFileSync(path.join(gallerySyncDir, outName), fs.readFileSync(path.join(localFolder, files[0])));
      return `/images/hotel-gallery/${outName}`;
    }
  }

  // 4. Check previously synced hotel-gallery
  if (fs.existsSync(gallerySyncDir)) {
    const existing = fs
      .readdirSync(gallerySyncDir)
      .find((f) => f.startsWith(`${key}.`) && imageExtRe.test(f));
    if (existing) return `/images/hotel-gallery/${existing}`;
  }

  return fallbackUrl;
}

