      <!-- Golden Scallop Shell Emblem -->
      <svg class="w-6 h-6 text-[#D6B66C]/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M12 20c4.5 0 8-3.2 8-7.5C20 8.5 16.5 5 12 5S4 8.5 4 12.5C4 16.8 7.5 20 12 20z" />
        <path d="M12 5v15M8 7l4 13M16 7l-4 13" stroke-linecap="round" />
      </svg>
    </div>
  </div>
</section>

<style>
  .journal-photo-card {
    transition:
      transform 0.38s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.38s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.3s ease;
    transform-origin: center center;
  }

  /* Slightly increase the hovered photo size in place while keeping the full image 100% visible */
  .journal-card-tall:hover,
  .journal-card-tall:focus-visible {
    transform: translateY(-5px) scale(1.16) rotate(0deg) !important;
    box-shadow:
      0 26px 60px rgba(0, 0, 0, 0.88),
      0 0 30px rgba(214, 182, 108, 0.42) !important;
    z-index: 60 !important;
  }

  .journal-card-compact:hover,
  .journal-card-compact:focus-visible {
    transform: translateY(-5px) scale(1.22) rotate(0deg) !important;
    box-shadow:
      0 26px 60px rgba(0, 0, 0, 0.88),
      0 0 30px rgba(214, 182, 108, 0.42) !important;
    z-index: 60 !important;
  }

  @media (max-width: 1023px) {
    .journal-card-tall:hover,
    .journal-card-compact:hover {
      transform: scale(1.08) rotate(0deg) !important;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({ ignoreMobileResize: true });

  const filterBtns = Array.from(document.querySelectorAll('.journal-filter-btn')) as HTMLElement[];
  const photoCards = Array.from(document.querySelectorAll('.journal-photo-card')) as HTMLElement[];

  function initGalleryOneByOneScroll() {
    const section = document.getElementById('gallery');
    if (!section || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const headerEls = section.querySelectorAll('h2, .journal-filter-btn');
    if (headerEls.length) {
      gsap.fromTo(
        headerEls,
        { opacity: 0, y: 20 },
        {
          opacity: 1,
          y: 0,
          duration: 0.55,
          stagger: 0.06,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: section,
            start: 'top 82%',
            toggleActions: 'play none none reverse',
          },
        }
      );
    }

    // One-by-One Sequential Entrance for Each Gallery Image Card
    if (photoCards.length) {
      photoCards.forEach((card, idx) => {
        gsap.fromTo(
          card,
          {
            opacity: 0,
            y: 65,
            scale: 0.84,
          },
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.72,
            delay: idx * 0.22,
            ease: 'back.out(1.35)',
            clearProps: 'transform,opacity',
            scrollTrigger: {
              trigger: section,
              start: 'top 88%',
              once: true,
            },
          }
        );
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGalleryOneByOneScroll);
  } else {
    initGalleryOneByOneScroll();
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.journalFilter || 'All Moments';

      filterBtns.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('bg-gradient-to-r', active);
        b.classList.toggle('from-[#D6B66C]', active);
        b.classList.toggle('to-[#E6C987]', active);
        b.classList.toggle('text-[#101416]', active);
        b.classList.toggle('border-[#D6B66C]', active);
        b.classList.toggle('font-semibold', active);
        b.classList.toggle('bg-[#101A1F]/75', !active);
        b.classList.toggle('text-[#E5DFD2]', !active);
      });

      photoCards.forEach((card) => {
        const cat = card.dataset.journalCategory;
        const match = target === 'All Moments' || cat === target;
        card.style.opacity = match ? '' : '0.28';
        card.style.filter = match ? '' : 'grayscale(65%)';
      });
    });
  });
</script>
