<!-- ════════════════════════════════════════════════════════════════════════════
     GSAP + SCROLLTRIGGER EDITORIAL ANIMATIONS
     - Alternating left/right horizontal image entrance
     - Staggered typography reveals
     - Natural scroll-triggered animation without hijacking scrolling
════════════════════════════════════════════════════════════════════════════ -->
<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  function initEditorialAnimations() {
    gsap.registerPlugin(ScrollTrigger);

    const rows = document.querySelectorAll('.experience-row');

    rows.forEach((row, index) => {
      const imgWrapper = row.querySelector('.experience-image-wrapper');
      const textContent = row.querySelector('.experience-text-content');
      const img = row.querySelector('.experience-img');
      const isEven = index % 2 === 1; // 02, 04, 06 are on the right

      if (imgWrapper && textContent) {
        // Horizontal Image Reveal Animation
        gsap.fromTo(
          imgWrapper,
          {
            opacity: 0,
            x: isEven ? 60 : -60,
            scale: 0.95
          },
          {
            opacity: 1,
            x: 0,
            scale: 1,
            duration: 1.0,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: row,
              start: 'top 82%',
              toggleActions: 'play none none none'
            }
          }
        );

        // Subtle image scale-down on scroll
        if (img) {
          gsap.fromTo(
            img,
            { scale: 1.12 },
            {
              scale: 1,
              duration: 1.2,
              ease: 'power2.out',
              scrollTrigger: {
                trigger: row,
                start: 'top 82%',
                toggleActions: 'play none none none'
              }
            }
          );
        }

        // Staggered Text Content Entrance
        gsap.fromTo(
          textContent,
          {
            opacity: 0,
            y: 40
          },
          {
            opacity: 1,
            y: 0,
            duration: 0.9,
            delay: 0.2,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: row,
              start: 'top 82%',
              toggleActions: 'play none none none'
            }
          }
        );
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEditorialAnimations);
  } else {
    initEditorialAnimations();
  }
</script>
