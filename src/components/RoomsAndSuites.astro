const targetDir = path.join(process.cwd(), 'public', 'images', 'rooms-collection');
const imageExtRe = /\.(webp|jpe?g|png|avif)$/i;

function pickFirstUniqueImage(
  candidateDirs: string[],
  outKey: string,
  fallbackUrl: string
): string {
  const existingDir = candidateDirs.find((d) => fs.existsSync(d));
  if (existingDir) {
    fs.mkdirSync(targetDir, { recursive: true });
    const files = fs
      .readdirSync(existingDir)
      .filter((f) => imageExtRe.test(f))
      .sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }));

    if (files.length > 0) {
      const srcPath = path.join(existingDir, files[0]);
      const buf = fs.readFileSync(srcPath);
      const ext = path.extname(files[0]).toLowerCase();
      const outName = `${outKey}${ext}`;
      // Remove older extension variants of same key
      for (const old of fs.readdirSync(targetDir)) {
        if (old.startsWith(`${outKey}.`) && old !== outName) {
          fs.unlinkSync(path.join(targetDir, old));
        }
      }
      fs.writeFileSync(path.join(targetDir, outName), buf);
      return `/images/rooms-collection/${outName}`;
    }
  }

  // Fallback on remote builds: check if already synced in public/images/rooms-collection
  if (fs.existsSync(targetDir)) {
    const synced = fs
      .readdirSync(targetDir)
      .find((f) => f.startsWith(`${outKey}.`) && imageExtRe.test(f));
    if (synced) return `/images/rooms-collection/${synced}`;
  }

  return fallbackUrl;
}

function syncUploadedImage(
  candidatePaths: string[],
  outKey: string,
  fallbackUrl: string
): string {
  const existingPath = candidatePaths.find((p) => fs.existsSync(p));
  if (existingPath) {
    fs.mkdirSync(targetDir, { recursive: true });
    const ext = path.extname(existingPath).toLowerCase() || '.jpg';
    const outName = `${outKey}${ext}`;
    for (const old of fs.readdirSync(targetDir)) {
      if (old.startsWith(`${outKey}.`) && old !== outName) {
        fs.unlinkSync(path.join(targetDir, old));
      }
    }
    fs.writeFileSync(path.join(targetDir, outName), fs.readFileSync(existingPath));
    return `/images/rooms-collection/${outName}`;
  }

  if (fs.existsSync(targetDir)) {
    const synced = fs
      .readdirSync(targetDir)
      .find((f) => f.startsWith(`${outKey}.`) && imageExtRe.test(f));
    if (synced) return `/images/rooms-collection/${synced}`;
  }

  return fallbackUrl;
}

